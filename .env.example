# ==================== BloodOra FRONTEND - Environment Configuration ====================
# Copy to .env for local development.
# On Vercel: Project -> Settings -> Environment Variables.

PORT=3000
NODE_ENV=development

# Secret used to sign the frontend's own browser session cookie.
SESSION_SECRET=change-me-frontend-session-secret

# ---------- Connection to the BACKEND (the other Vercel project) ----------
# The exact URL of the separated backend API deployment.
# Example: BACKEND_URL=https://bloodora-api.vercel.app
BACKEND_URL=http://localhost:4000

# NOTE: The backend never needs this project's secret, and this project never
# needs the backend's JWT_SECRET or database credentials. The ONLY link between
# the two deployments is BACKEND_URL (here) and FRONTEND_URL (on the backend).
