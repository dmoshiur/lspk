<%- include('partials/header') %>
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-lg text-center p-4 p-lg-5" style="border-radius:22px;">
        <div class="mx-auto d-flex align-items-center justify-content-center" style="width:72px;height:72px;border-radius:50%; background:linear-gradient(135deg,#16a34a,#22c55e); color:#fff; font-size:28px; box-shadow:0 10px 28px rgba(22,163,74,.3);"><i class="fas fa-check"></i></div>
        <h2 class="fw-bold mt-3" style="letter-spacing:-.02em; color:#14532d;">Order Placed Successfully!</h2>
        <p class="text-muted">Your order <strong>#<%= order.id %></strong> has been received. Admin will confirm your payment and process it.</p>
        <div class="row g-3 text-start mt-2">
          <div class="col-md-6"><div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="small text-muted">Order Total</div><div class="h5 fw-bold mb-0" style="color:var(--primary);">৳<%= order.total_amount %> <small class="text-muted" style="font-size:.8rem;">(incl. ৳<%= order.delivery_charge %> delivery)</small></div></div></div>
          <div class="col-md-6"><div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="small text-muted">Payment</div><div class="fw-bold"><%= order.payment_method %> • <span class="badge <%= order.payment_status==='confirmed'?'bg-success':'bg-warning text-dark' %>"><%= order.payment_status %></span></div><div class="small text-muted"><%= order.transaction_id||'No TrxID (COD)' %></div></div></div>
          <div class="col-12"><div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="small text-muted">Delivery Address</div><div class="fw-bold"><%= order.delivery_address %></div><div class="small"><%= order.delivery_upazila %>, <%= order.delivery_district %>, <%= order.delivery_division %></div></div></div>
        </div>
        <% if (items && items.length) { %>
          <div class="text-start mt-4">
            <h6 class="fw-bold"><i class="fas fa-list me-2 text-danger"></i>Items</h6>
            <div class="table-responsive">
              <table class="table small"><thead><tr><th>Product</th><th>Qty</th><th>Price</th><th>Subtotal</th></tr></thead><tbody>
                <% items.forEach(it=>{ %><tr><td><%= it.product_name %></td><td><%= it.quantity %></td><td>৳<%= it.price %></td><td class="fw-bold">৳<%= (it.price*it.quantity).toFixed(2) %></td></tr><% }) %>
              </tbody></table>
            </div>
          </div>
        <% } %>
        <div class="d-flex gap-2 justify-content-center mt-4">
          <a href="/shop" class="btn btn-light border rounded-pill"><i class="fas fa-shopping-bag me-1"></i>Continue Shopping</a>
          <a href="/shop/my-orders" class="btn btn-danger rounded-pill"><i class="fas fa-box me-1"></i>My Orders</a>
          <% if (currentUser && currentUser.is_admin) { %><a href="/shop/admin/order/<%= order.id %>/invoice" class="btn btn-outline-danger rounded-pill"><i class="fas fa-file-invoice me-1"></i>Invoice</a><% } %>
        </div>
        <div class="small text-muted mt-3">📦 Delivery only in Kalai • Rider will call before delivery. Save Order ID #<%= order.id %>.</div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
