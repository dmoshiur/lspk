<%
  const _t = (typeof t === 'function') ? t : (k) => k;
%>
<%- include('partials/header') %>
<div class="container mt-4">
  <h2 class="fw-bold mb-3"><i class="fas fa-question-circle text-danger me-2"></i><%= _t('nav_faq') %></h2>
  <div class="accordion" id="faq">
    <div class="accordion-item" style="border-radius:14px; overflow:hidden; margin-bottom:12px; border:1px solid #e2e8f0;">
      <h2 class="accordion-header"><button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#f1"><%= _t('faq_q1') %></button></h2>
      <div id="f1" class="accordion-collapse collapse show" data-bs-parent="#faq"><div class="accordion-body text-muted"><%= _t('faq_a1') %></div></div>
    </div>
    <div class="accordion-item" style="border-radius:14px; overflow:hidden; margin-bottom:12px; border:1px solid #e2e8f0;">
      <h2 class="accordion-header"><button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#f2"><%= _t('faq_q2') %></button></h2>
      <div id="f2" class="accordion-collapse collapse" data-bs-parent="#faq"><div class="accordion-body text-muted"><%= _t('faq_a2') %></div></div>
    </div>
    <div class="accordion-item" style="border-radius:14px; overflow:hidden; margin-bottom:12px; border:1px solid #e2e8f0;">
      <h2 class="accordion-header"><button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#f3"><%= _t('faq_q3') %></button></h2>
      <div id="f3" class="accordion-collapse collapse" data-bs-parent="#faq"><div class="accordion-body text-muted"><%= _t('faq_a3') %></div></div>
    </div>
    <div class="accordion-item" style="border-radius:14px; overflow:hidden; border:1px solid #e2e8f0;">
      <h2 class="accordion-header"><button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#f4"><%= _t('faq_q4') %></button></h2>
      <div id="f4" class="accordion-collapse collapse" data-bs-parent="#faq"><div class="accordion-body text-muted"><%= _t('faq_a4') %></div></div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
