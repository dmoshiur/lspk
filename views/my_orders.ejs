<%- include('partials/header') %>
<div class="container mt-4">
  <h2 class="fw-bold mb-3"><i class="fas fa-box text-danger me-2"></i>My Orders</h2>
  <% if (orders && orders.length) { %>
    <div class="card border-0 shadow-sm" style="border-radius:18px;">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead><tr><th>Order ID</th><th>Date</th><th>Total</th><th>Payment</th><th>Status</th><th>Invoice</th></tr></thead>
          <tbody>
            <% orders.forEach(order=>{ %>
              <tr>
                <td class="fw-bold">#<%= order.id %></td>
                <td class="small text-muted"><%= new Date(order.created_at).toISOString().slice(0,10) %></td>
                <td class="fw-bold" style="color:var(--primary);">৳<%= order.total_amount %></td>
                <td><span class="badge <%= order.payment_status==='confirmed'?'bg-success':'bg-warning text-dark' %>"><%= order.payment_method||'—' %></span></td>
                <td>
                  <% if(order.status==='pending'){ %><span class="badge bg-warning text-dark">Pending</span>
                  <% } else if(order.status==='processing'){ %><span class="badge bg-info">Processing</span>
                  <% } else if(order.status==='completed'){ %><span class="badge bg-success">Completed</span>
                  <% } else { %><span class="badge bg-secondary"><%= order.status %></span><% } %>
                </td>
                <td><a href="/shop/order/success/<%= order.id %>" class="btn btn-sm btn-outline-danger rounded-pill"><i class="fas fa-eye me-1"></i>View</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="card border-0 shadow-sm text-center p-5" style="border-radius:18px;"><i class="fas fa-box-open fa-3x mb-3" style="color:#94a3b8;"></i><h5>No orders yet</h5><p class="text-muted">Start shopping to see orders here.</p><a href="/shop" class="btn btn-danger rounded-pill">Go to Shop</a></div>
  <% } %>
</div>
<%- include('partials/footer') %>
