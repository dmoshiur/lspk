<%
  const _t   = (typeof t === 'function') ? t : (k) => k;
  // EJS's escaped output tag escapes exactly once. The old local escaper ran on
  // top of it and leaked literal &#39; / &amp; sequences into the rendered page.
  const _stars = (n) => { const f = Math.max(0, Math.min(5, Number(n) || 0)); return '★'.repeat(Math.round(f)) + '☆'.repeat(5 - Math.round(f)); };
  const BADGE = { pending: 'bg-warning text-dark', approved: 'bg-success', rejected: 'bg-secondary' };
%>
<%- include('partials/header') %>

<div class="container mt-4 mb-5">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div>
      <div class="eyebrow mb-1"><%= _t('dash_title') %></div>
      <h1 class="display-title mb-0"><i class="fas fa-star text-warning me-2"></i><%= _t('rev_write') %></h1>
    </div>
    <a href="/reviews" class="btn btn-outline-danger"><i class="fas fa-list me-1"></i><%= _t('rev_all') %></a>
  </div>

  <% if (reviews.length) { %>
    <div class="row g-3">
      <% reviews.forEach(function(r){ %>
        <div class="col-md-6">
          <div class="card h-100 border-0 shadow-sm" style="border-radius:20px;">
            <div class="card-body p-4">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stars"><%= _stars(r.rating) %></span>
                <span class="badge <%= BADGE[r.status] || 'bg-light text-dark border' %>"><%= (label && label[r.status]) || _t('rev_' + r.status, {}) || r.status %></span>
              </div>
              <h5 class="fw-bold mb-1" style="font-family:var(--font-display); font-size:1.15rem;"><%= r.title || _t('rev_title') %></h5>
              <% if (r.product_name) { %><div class="small text-muted mb-2"><i class="fas fa-bag-shopping me-1 text-danger"></i><%= r.product_name %></div><% } %>
              <p class="small text-muted mb-2" style="line-height:1.7;"><%= r.body %></p>
              <% if (r.admin_reply) { %>
                <div class="p-3 rounded-4 mt-2" style="background:#f8fafc; border:1px solid #e2e8f0;">
                  <div class="small fw-bold text-danger mb-1"><i class="fas fa-reply me-1"></i><%= _t('rev_official') %></div>
                  <div class="small text-muted"><%= r.admin_reply %></div>
                </div>
              <% } %>
              <div class="small text-muted mt-2"><i class="fas fa-clock me-1"></i><%= r.created_at ? String(r.created_at).slice(0,16) : '' %></div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="alert alert-info text-center border-0 shadow-sm rounded-4 py-4">
      <i class="fas fa-star fa-2x d-block mb-2 text-warning"></i>
      <%= _t('rev_mine_empty') %>
      <div class="mt-3"><a href="/reviews" class="btn btn-danger rounded-pill px-4"><i class="fas fa-pen me-1"></i><%= _t('rev_write') %></a></div>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
