<%- include('partials/header') %>
<div class="container mt-4">
  <div class="row g-4">
    <div class="col-lg-6">
      <h2 class="fw-bold mb-3"><i class="fas fa-envelope text-danger me-2"></i>Contact Us</h2>
      <div class="card border-0 shadow-sm" style="border-radius:18px;">
        <div class="card-body p-4">
          <div class="d-grid gap-3">
            <div class="d-flex gap-3 p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="d-flex align-items-center justify-content-center" style="width:46px;height:46px;border-radius:50%; background:var(--primary); color:#fff;"><i class="fas fa-envelope"></i></div><div><div class="small text-muted">Email</div><div class="fw-bold"><%= settings && settings.site_email ? settings.site_email : 'info.bloodora@gmail.com' %></div></div></div>
            <div class="d-flex gap-3 p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="d-flex align-items-center justify-content-center" style="width:46px;height:46px;border-radius:50%; background:#0f172a; color:#fff;"><i class="fas fa-phone"></i></div><div><div class="small text-muted">Phone</div><div class="fw-bold"><%= settings && settings.site_phone ? settings.site_phone : '+8801709202140' %></div></div></div>
            <div class="d-flex gap-3 p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="d-flex align-items-center justify-content-center" style="width:46px;height:46px;border-radius:50%; background:#16a34a; color:#fff;"><i class="fas fa-map-marker-alt"></i></div><div><div class="small text-muted">Address</div><div class="fw-bold"><%= settings && settings.site_address ? settings.site_address : 'Kalai, Joypurhat, Bangladesh' %></div></div></div>
          </div>
          <div class="mt-4 p-3 rounded-4" style="background:#fffbeb; border:1px solid #fde68a;">
            <div class="small fw-bold"><i class="fas fa-bolt me-1 text-warning"></i>Serverless delivery note</div>
            <div class="small text-muted">Shop delivery only in Kalai (৳10). For blood, we connect you instantly — always verify by phone.</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm" style="border-radius:18px;">
        <div class="card-body p-4">
          <h5 class="fw-bold"><i class="fas fa-paper-plane me-2 text-danger"></i>Send a Message</h5>
          <p class="small text-muted">Messages go to admin inbox (Turso).</p>
          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <form method="POST" action="/messages/send" class="d-grid gap-3">
              <input name="subject" class="form-control" placeholder="Subject" required>
              <textarea name="content" class="form-control" rows="4" placeholder="Your message..." required></textarea>
              <button class="btn btn-danger rounded-pill">Send Message</button>
            </form>
          <% } else { %>
            <div class="alert alert-warning border-0 rounded-4">Please <a href="/login">login</a> to send a direct message. Or email us at <%= settings && settings.site_email ? settings.site_email : 'info.bloodora@gmail.com' %>.</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
