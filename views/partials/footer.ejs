<%
  const _t   = (typeof t === 'function') ? t : (k) => k;
  const _b   = (typeof branding !== 'undefined' && branding) ? branding : {};
  const _s   = _b;
  const _dir = (typeof dir !== 'undefined' && dir) ? dir : 'ltr';
  const _lang= (typeof lang !== 'undefined' && lang) ? lang : 'en';
  const _name= _b.site_name || 'BloodOra';
  const _logo= '/' + (_b.logo_file || 'logo.png');
  const _p   = _b.brand_primary || '#e31b23';
  const _aiOn    = _b.ai_enabled !== false;
  const _chatOn  = _b.live_chat_enabled !== false;
  const _isLogged = (typeof currentUser !== 'undefined' && currentUser);
%>
  <!-- ================= Footer ================= -->
  <footer class="footer">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-4">
          <h5 class="d-flex align-items-center gap-2">
            <img src="<%= _logo %>" alt="<%= _name %>" style="height:38px;" onerror="this.style.display='none'"><%= _name %>
          </h5>
          <% if (_b.site_tagline) { %><p class="script-accent mt-2 mb-0" style="color:#f1a4ab; font-size:1.15rem;"><%= _b.site_tagline %></p><% } %>
          <p class="mt-2" style="color:#94a3b8; max-width:38ch;"><%= _b.site_description || "Bangladesh's smart blood donation platform — connecting verified donors, urgent requests, and a complete medical shop in one place." %></p>
          <div class="social-icons mt-3">
            <a href="<%= _s.facebook_url && _s.facebook_url !== '#' ? _s.facebook_url : '#' %>" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
            <a href="<%= _s.twitter_url && _s.twitter_url !== '#' ? _s.twitter_url : '#' %>" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
            <a href="<%= _s.instagram_url && _s.instagram_url !== '#' ? _s.instagram_url : '#' %>" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
            <a href="<%= _s.linkedin_url && _s.linkedin_url !== '#' ? _s.linkedin_url : '#' %>" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
          </div>
        </div>

        <div class="col-6 col-lg-2">
          <h6 class="text-white fw-bold mb-3"><%= _t('foot_platform') %></h6>
          <ul class="list-unstyled d-grid gap-2">
            <li><a href="/donors"><%= _t('nav_donors') %></a></li>
            <li><a href="/blood-requests"><%= _t('nav_requests') %></a></li>
            <li><a href="/request-blood"><%= _t('nav_request') %></a></li>
            <li><a href="/shop"><%= _t('shop_title') %></a></li>
            <li><a href="/reviews"><%= _t('rev_title') %></a></li>
          </ul>
        </div>

        <div class="col-6 col-lg-2">
          <h6 class="text-white fw-bold mb-3"><%= _t('foot_resources') %></h6>
          <ul class="list-unstyled d-grid gap-2">
            <li><a href="/resources"><%= _t('nav_education') %></a></li>
            <li><a href="/antid"><%= _t('nav_antid') %></a></li>
            <li><a href="/compatibility"><%= _t('nav_compatibility') %></a></li>
            <li><a href="/donation-guidelines"><%= _t('nav_guidelines') %></a></li>
            <li><a href="/faq"><%= _t('nav_faq') %></a></li>
          </ul>
        </div>

        <div class="col-lg-4">
          <h6 class="text-white fw-bold mb-3"><%= _t('foot_contact') %></h6>
          <ul class="list-unstyled d-grid gap-2" style="color:#94a3b8;">
            <li><i class="fas fa-envelope me-2 text-danger"></i><%= _s.site_email || 'info.bloodora@gmail.com' %></li>
            <li><i class="fas fa-phone me-2 text-danger"></i><%= _s.site_phone || '+8801709202140' %></li>
            <li><i class="fas fa-map-marker-alt me-2 text-danger"></i><%= _s.site_address || 'Kalai, Joypurhat, Bangladesh' %></li>
          </ul>
          <div class="mt-3 d-flex flex-wrap gap-2">
            <a href="/contact" class="btn btn-sm btn-outline-light rounded-pill" style="border-color:rgba(255,255,255,.2);"><i class="fas fa-headset me-1"></i><%= _t('chat_title') %></a>
          </div>
          <div class="small mt-3" style="color:#64748b;"><i class="fas fa-truck me-1"></i><%= _t('shop_delivery') %></div>
        </div>
      </div>

      <hr style="border-color:rgba(255,255,255,.08); margin:34px 0 20px;">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small" style="color:#64748b;">
        <div>© <%= new Date().getFullYear() %> <strong style="color:#94a3b8;"><%= _name %></strong> — <%= _t('foot_rights') %></div>
        <div class="d-flex gap-3 align-items-center flex-wrap">
          <a href="/contact" style="color:#64748b;"><%= _t('nav_contact') %></a>
          <span>•</span>
          <a href="/reviews" style="color:#64748b;"><%= _t('rev_title') %></a>
          <span>•</span>
          <span><%= _t('shop_delivery') %></span>
        </div>
      </div>
    </div>
  </footer>

  <!-- ================= Floating help widgets ================= -->
  <div id="bo-widgets" style="position:fixed; <%= _dir==='rtl'?'left':'right' %>:18px; bottom:18px; z-index:1080; display:flex; flex-direction:column; align-items:flex-end; gap:12px;">

    <!-- ---------- Live Messaging (real human support) ---------- -->
    <% if (_chatOn) { %>
    <div id="bo-chat-wrap" style="position:relative;">
      <button id="bo-chat-fab" class="widget-fab fab-chat" aria-label="<%= _t('chat_title') %>">
        <i class="fas fa-comments"></i>
        <span id="bo-chat-unread" class="unread-pill d-none">0</span>
      </button>
      <div id="bo-chat-panel" class="widget-panel d-none" style="<%= _dir==='rtl'?'left':'right' %>:0;">
        <div class="widget-head widget-head-chat">
          <div>
            <div class="fw-bold" style="font-family:var(--font-display); font-size:1.05rem;"><i class="fas fa-headset me-2"></i><%= _t('chat_title') %></div>
            <div class="small" style="opacity:.9;"><span id="bo-chat-status"><span class="live-dot"></span>Online</span></div>
          </div>
          <button id="bo-chat-close" class="btn btn-sm" style="background:rgba(255,255,255,.2); border:none; color:#fff; width:32px; height:32px; border-radius:50%; padding:0;"><i class="fas fa-times"></i></button>
        </div>
        <div id="bo-chat-body" class="widget-body"></div>
        <div class="widget-foot">
          <div class="d-flex gap-2">
            <input id="bo-chat-input" class="form-control" placeholder="<%= _t('chat_placeholder') %>" style="border-radius:999px;" maxlength="2000">
            <button id="bo-chat-send" class="btn btn-danger" style="border-radius:50%; width:42px; height:42px; padding:0; display:flex; align-items:center; justify-content:center;"><i class="fas fa-paper-plane"></i></button>
          </div>
          <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
            <span id="bo-chat-name"><%= _isLogged ? currentUser.name : 'Guest' %></span>
            <% if (_aiOn) { %><a href="#" id="bo-chat-to-ai" style="color:#4f46e5; font-weight:600;"><i class="fas fa-robot me-1"></i><%= _t('chat_ai') %></a><% } %>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- ---------- Live AI Help ---------- -->
    <% if (_aiOn) { %>
    <div id="bo-ai-wrap" style="position:relative;">
      <button id="bo-ai-fab" class="widget-fab fab-ai" aria-label="<%= _t('chat_ai_title') %>">
        <i class="fas fa-robot"></i>
      </button>
      <div id="bo-ai-panel" class="widget-panel d-none" style="<%= _dir==='rtl'?'left':'right' %>:0;">
        <div class="widget-head widget-head-ai">
          <div>
            <div class="fw-bold" style="font-family:var(--font-display); font-size:1.05rem;"><i class="fas fa-wand-magic-sparkles me-2"></i><%= _t('chat_ai_title') %></div>
            <div class="small" style="opacity:.92;"><span id="bo-ai-model"><%= _b.ai_model || 'qwen/qwen3.6-27b' %></span></div>
          </div>
          <div class="d-flex gap-1">
            <button id="bo-ai-reset" class="btn btn-sm" title="New conversation" style="background:rgba(255,255,255,.2); border:none; color:#fff; width:32px; height:32px; border-radius:50%; padding:0;"><i class="fas fa-rotate-right"></i></button>
            <button id="bo-ai-close" class="btn btn-sm" style="background:rgba(255,255,255,.2); border:none; color:#fff; width:32px; height:32px; border-radius:50%; padding:0;"><i class="fas fa-times"></i></button>
          </div>
        </div>
        <div class="widget-body" style="background:linear-gradient(180deg,#f5f3ff,#f8fafc);">
          <div class="small mb-2" style="color:#4c1d95;"><%= _t('chat_ai_sub') %></div>
          <div id="bo-ai-chips" class="d-flex flex-wrap gap-2 mb-3"></div>
          <div id="bo-ai-body"></div>
        </div>
        <div class="widget-foot">
          <div class="d-flex gap-2">
            <input id="bo-ai-input" class="form-control" placeholder="<%= _t('chat_placeholder') %>" style="border-radius:999px;" maxlength="4000">
            <button id="bo-ai-send" class="btn" style="border-radius:50%; width:42px; height:42px; padding:0; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#4f46e5,#7c3aed); color:#fff;"><i class="fas fa-paper-plane"></i></button>
          </div>
          <% if (_chatOn) { %><div class="small text-muted mt-2 text-end"><a href="#" id="bo-ai-to-chat" style="color:var(--primary); font-weight:600;"><i class="fas fa-user-headset me-1"></i><%= _t('chat_human') %></a></div><% } %>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <!-- ================================================================= -->
  <script>
  (function(){
    var LANG = <%- JSON.stringify(_lang) %>;
    var I18N = {
      thinking: <%- JSON.stringify(_t('chat_thinking')) %>,
      you: <%- JSON.stringify(_t('chat_you')) %>,
      support: <%- JSON.stringify(_t('chat_support')) %>,
      offline: <%- JSON.stringify(_t('chat_offline')) %>,
      loading: <%- JSON.stringify(_t('common_loading')) %>
    };

    // ---- tiny markdown renderer: links + bold + line breaks, HTML-escaped first ----
    function esc(s){ return String(s).replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
    function md(text){
      var out = esc(text);
      out = out.replace(/\[([^\]]+)\]\((\/[^)\s]*)\)/g, function(_, label, href){
        return '<a href="' + href + '" data-bo-link>' + label + '</a>';
      });
      out = out.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      out = out.replace(/`([^`]+)`/g, '<code>$1</code>');
      out = out.replace(/\n/g, '<br>');
      return out;
    }
    function bubble(cls, html){
      var d = document.createElement('div');
      d.className = 'chat-bubble ' + cls;
      d.innerHTML = html;
      return d;
    }
    function stamp(iso){
      try { var d = new Date(String(iso).includes('T') ? iso : iso.replace(' ', 'T') + 'Z'); return d.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}); }
      catch(e){ return ''; }
    }

    /* ============================== LIVE AI HELP ============================== */
    var aiState = { conv: null, busy: false, prompts: [] };
    var aiPanel = document.getElementById('bo-ai-panel');
    var aiBody  = document.getElementById('bo-ai-body');
    var aiInput = document.getElementById('bo-ai-input');

    function aiSay(text, cls){ if (aiBody) aiBody.appendChild(bubble(cls || 'msg-bot', md(text))); aiScroll(); }
    function aiScroll(){ if (aiPanel) { var b = aiPanel.querySelector('.widget-body'); if (b) b.scrollTop = b.scrollHeight; } }

    function aiTyping(on){
      var el = document.getElementById('bo-ai-typing');
      if (on) {
        if (!el) { el = bubble('msg-bot', '<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>'); el.id = 'bo-ai-typing'; aiBody.appendChild(el); aiScroll(); }
      } else if (el) { el.remove(); }
    }

    function aiRenderChips(){
      var box = document.getElementById('bo-ai-chips');
      if (!box) return;
      box.innerHTML = '';
      aiState.prompts.forEach(function(p){
        var c = document.createElement('button');
        c.type = 'button'; c.className = 'chip'; c.textContent = p;
        c.onclick = function(){ aiInput.value = p; aiSend(); };
        box.appendChild(c);
      });
    }

    function aiSend(){
      var text = (aiInput.value || '').trim();
      if (!text || aiState.busy) return;
      aiInput.value = '';
      aiSay(text, 'msg-user');
      aiState.busy = true;
      aiTyping(true);
      fetch('/ai-help/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ message: text, conversation_id: aiState.conv, language: LANG })
      })
      .then(function(r){ return r.json(); })
      .then(function(d){
        aiTyping(false);
        if (d.success) {
          aiState.conv = d.conversation_id || aiState.conv;
          aiSay(d.reply, 'msg-bot');
        } else {
          aiSay('⚠️ ' + (d.message || I18N.offline), 'msg-bot');
        }
      })
      .catch(function(e){ aiTyping(false); aiSay('⚠️ ' + I18N.offline, 'msg-bot'); })
      .finally(function(){ aiState.busy = false; });
    }

    if (aiPanel) {
      document.getElementById('bo-ai-fab').onclick = function(){ aiPanel.classList.toggle('d-none'); if (!aiPanel.classList.contains('d-none')) aiInput.focus(); };
      document.getElementById('bo-ai-close').onclick = function(){ aiPanel.classList.add('d-none'); };
      document.getElementById('bo-ai-send').onclick = aiSend;
      aiInput.addEventListener('keydown', function(e){ if (e.key === 'Enter') aiSend(); });
      document.getElementById('bo-ai-reset').onclick = function(){
        aiState.conv = null; aiBody.innerHTML = '';
        aiSay('👋 ' + (LANG === 'bn' ? 'নতুন কথোপকথন শুরু হলো। কী জানতে চান?' : LANG === 'ar' ? 'بدأت محادثة جديدة. عمّا تسأل؟' : 'New conversation started. What would you like to know?'), 'msg-bot');
        aiRenderChips();
      };
      var toChat = document.getElementById('bo-ai-to-chat');
      if (toChat) toChat.onclick = function(e){ e.preventDefault(); aiPanel.classList.add('d-none'); document.getElementById('bo-chat-fab').click(); };
      fetch('/ai-help/config').then(function(r){ return r.json(); }).then(function(d){
        if (d && d.enabled === false) { document.getElementById('bo-ai-fab').style.opacity = .45; }
        if (d && d.model) { document.getElementById('bo-ai-model').textContent = d.model; }
        aiState.prompts = (d && d.prompts) || [];
        aiRenderChips();
      }).catch(function(){});
      aiSay(LANG === 'bn'
        ? 'আসসালামু আলাইকুম! আমি BloodOra-এর এআই সহায়ক। পেজ, ফিচার, দাম, অ্যান্টি-ডি কিংবা রক্তের সামঞ্জস্যতা — যা খুশি জিজ্ঞাসা করুন।'
        : LANG === 'ar'
        ? 'السلام عليكم! أنا مساعد BloodOra الذكي. اسألني عن أي صفحة أو ميزة أو سعر أو عن مضاد D وتوافق فصائل الدم.'
        : 'Assalamu alaikum! I am the BloodOra AI assistant. Ask me about any page, feature, price, Anti-D or blood compatibility.', 'msg-bot');
    }

    /* ============================== LIVE MESSAGING ============================== */
    var chatPanel = document.getElementById('bo-chat-panel');
    var chatBody  = document.getElementById('bo-chat-body');
    var chatInput = document.getElementById('bo-chat-input');
    var chatState = { key: null, lastId: 0, stream: null, poll: null, opened: false, unread: 0 };

    function chatSay(html, cls){ if (chatBody) chatBody.appendChild(bubble(cls || 'msg-bot', html)); chatScroll(); }
    function chatScroll(){ if (chatPanel) { var b = chatPanel.querySelector('.widget-body'); if (b) b.scrollTop = b.scrollHeight; } }
    function bumpUnread(){
      chatState.unread++;
      var pill = document.getElementById('bo-chat-unread');
      if (pill) { pill.textContent = chatState.unread; pill.classList.remove('d-none'); }
    }
    function clearUnread(){
      chatState.unread = 0;
      var pill = document.getElementById('bo-chat-unread');
      if (pill) pill.classList.add('d-none');
    }
    function renderMsg(m){
      if (m.id && m.id <= chatState.lastId) return;
      if (m.id) chatState.lastId = m.id;
      var mine = m.sender_type === 'visitor';
      var who  = mine ? I18N.you : (m.sender_name || I18N.support);
      chatSay('<div class="small fw-bold mb-1" style="opacity:.75;">' + esc(who) + ' · ' + stamp(m.created_at) + '</div>' + md(m.body), mine ? 'msg-user' : 'msg-bot');
      if (!mine && chatPanel && chatPanel.classList.contains('d-none')) bumpUnread();
    }

    function chatOpenStream(){
      if (!chatState.key || typeof EventSource === 'undefined') return;
      try {
        var es = new EventSource('/support/stream?session=' + encodeURIComponent(chatState.key));
        chatState.stream = es;
        es.addEventListener('message', function(ev){
          try {
            var d = JSON.parse(ev.data);
            if (d.type === 'message' && d.message) renderMsg(d.message);
            if (d.type === 'closed') chatSay('🔒 ' + (LANG==='bn'?'কথোপকথন বন্ধ করা হয়েছে।':'Conversation closed.'), 'msg-bot');
          } catch(e){}
        });
        es.onerror = function(){ es.close(); chatState.stream = null; chatStartPolling(); };
      } catch(e){ chatStartPolling(); }
    }
    function chatStartPolling(){
      if (chatState.poll) return;
      chatState.poll = setInterval(function(){
        if (!chatState.key) return;
        fetch('/support/messages?session=' + encodeURIComponent(chatState.key) + '&after=' + chatState.lastId)
          .then(function(r){ return r.json(); })
          .then(function(d){ (d.messages || []).forEach(renderMsg); })
          .catch(function(){});
      }, 6000);
    }

    function chatInit(){
      if (chatState.opened) return;
      chatState.opened = true;
      chatSay('<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>', 'msg-bot');
      fetch('/support/session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ session_key: localStorage.getItem('bo_chat_key') })
      })
      .then(function(r){ return r.json(); })
      .then(function(d){
        chatBody.innerHTML = '';
        chatState.lastId = 0;
        if (d.greeting) chatSay('<strong>' + esc(I18N.support) + '</strong><br>' + md(d.greeting), 'msg-bot');
        chatState.key = d.session_key;
        localStorage.setItem('bo_chat_key', chatState.key);
        (d.messages || []).forEach(renderMsg);
        document.getElementById('bo-chat-status').innerHTML = '<span class="live-dot"></span>' + (LANG==='bn'?'সংযুক্ত':'Connected');
        chatOpenStream();
      })
      .catch(function(){
        chatBody.innerHTML = '';
        chatSay('⚠️ ' + (LANG==='bn'?'সার্ভারে সংযোগ করা যাচ্ছে না। আবার চেষ্টা করুন।':'Could not reach the support server. Please try again.'), 'msg-bot');
        chatState.opened = false;
      });
    }

    function chatSend(){
      var text = (chatInput.value || '').trim();
      if (!text) return;
      chatInput.value = '';
      chatSay('<div class="small fw-bold mb-1" style="opacity:.75;">' + esc(I18N.you) + '</div>' + md(text), 'msg-user');
      fetch('/support/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ session_key: chatState.key, body: text })
      })
      .then(function(r){ return r.json(); })
      .then(function(d){ if (d.success && d.message) renderMsg(d.message); else if (d.message) chatSay('⚠️ ' + esc(d.message), 'msg-bot'); })
      .catch(function(){ chatSay('⚠️ ' + (LANG==='bn'?'পাঠানো যায়নি।':'Message failed to send.'), 'msg-bot'); });
    }

    if (chatPanel) {
      document.getElementById('bo-chat-fab').onclick = function(){
        chatPanel.classList.toggle('d-none');
        if (!chatPanel.classList.contains('d-none')) { clearUnread(); chatInit(); chatInput.focus(); }
      };
      document.getElementById('bo-chat-close').onclick = function(){ chatPanel.classList.add('d-none'); };
      document.getElementById('bo-chat-send').onclick = chatSend;
      chatInput.addEventListener('keydown', function(e){ if (e.key === 'Enter') chatSend(); });
      var toAi = document.getElementById('bo-chat-to-ai');
      if (toAi) toAi.onclick = function(e){ e.preventDefault(); chatPanel.classList.add('d-none'); document.getElementById('bo-ai-fab').click(); };
      // keep the unread badge accurate even when the panel is closed
      setInterval(function(){
        if (!chatState.key || !chatPanel.classList.contains('d-none')) return;
        fetch('/support/messages?session=' + encodeURIComponent(chatState.key) + '&after=' + chatState.lastId)
          .then(function(r){ return r.json(); })
          .then(function(d){ (d.messages || []).forEach(renderMsg); })
          .catch(function(){});
      }, 15000);
    }

    // Anywhere an AI answer links to a page, keep the click inside the site.
    document.addEventListener('click', function(e){
      var a = e.target.closest && e.target.closest('[data-bo-link]');
      if (a) { document.querySelectorAll('.widget-panel').forEach(function(p){ p.classList.add('d-none'); }); }
    });
  })();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Auto-dismiss flash messages after 4.5s
    setTimeout(function(){
      document.querySelectorAll('.alert-dismissible').forEach(function(a){
        try { bootstrap.Alert.getOrCreateInstance(a).close(); } catch(e) { a.remove(); }
      });
    }, 4500);
  </script>
</body>
</html>
