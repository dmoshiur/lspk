<%
  const _t   = (typeof t === 'function') ? t : (k) => k;
  const _b   = (typeof branding !== 'undefined' && branding) ? branding : {};
  const _s   = _b;
  const _dir = (typeof dir !== 'undefined' && dir) ? dir : 'ltr';
  const _lang= (typeof lang !== 'undefined' && lang) ? lang : 'en';
  const _name= _b.site_name || 'BloodOra';
  const resolveAssetUrl = (url, fallback) => {
    const target = (url && String(url).trim()) || fallback;
    if (!target) return '';
    if (target.startsWith('http://') || target.startsWith('https://') || target.startsWith('//') || target.startsWith('/')) {
      return target;
    }
    return '/' + target;
  };
  const _logo= resolveAssetUrl(_b.logo_file, 'https://i.postimg.cc/Yh2VJ3f0/382eae28-a8b6-4e1d-b76a-a619bbc7ed06.png');
  const _p   = _b.brand_primary || '#e31b23';
  const _aiOn    = _b.ai_enabled !== false;
  const _chatOn  = _b.live_chat_enabled !== false;
  const _isLogged = (typeof currentUser !== 'undefined' && currentUser);
%>
  </main>

  <!-- ================= Footer ================= -->
  <footer class="footer">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-4">
          <h5 class="d-flex align-items-center gap-2">
            <img src="<%= _logo %>" alt="<%= _name %>" style="height:38px;" onerror="this.style.display='none'"><%= _name %>
          </h5>
          <% if (_b.site_tagline) { %><p class="script-accent mt-2 mb-0" style="color:#f1a4ab; font-size:1.15rem;"><%= _b.site_tagline %></p><% } %>
          <p class="mt-2" style="color:#94a3b8; max-width:38ch;"><%= _b.site_description || "Bangladesh's smart blood donation platform — connecting verified donors, urgent requests, and a complete medical shop in one place." %></p>
          <div class="social-icons mt-3">
            <a href="<%= _s.facebook_url && _s.facebook_url !== '#' ? _s.facebook_url : '#' %>" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
            <a href="<%= _s.twitter_url && _s.twitter_url !== '#' ? _s.twitter_url : '#' %>" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
            <a href="<%= _s.instagram_url && _s.instagram_url !== '#' ? _s.instagram_url : '#' %>" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
            <a href="<%= _s.linkedin_url && _s.linkedin_url !== '#' ? _s.linkedin_url : '#' %>" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
          </div>
        </div>

        <div class="col-6 col-lg-2">
          <h6 class="text-white fw-bold mb-3"><%= _t('foot_platform') %></h6>
          <ul class="list-unstyled d-grid gap-2">
            <li><a href="/donors"><%= _t('nav_donors') %></a></li>
            <li><a href="/blood-requests"><%= _t('nav_requests') %></a></li>
            <li><a href="/request-blood"><%= _t('nav_request') %></a></li>
            <li><a href="/shop"><%= _t('shop_title') %></a></li>
            <li><a href="/reviews"><%= _t('rev_title') %></a></li>
          </ul>
        </div>

        <div class="col-6 col-lg-2">
          <h6 class="text-white fw-bold mb-3"><%= _t('foot_resources') %></h6>
          <ul class="list-unstyled d-grid gap-2">
            <li><a href="/resources"><%= _t('nav_education') %></a></li>
            <li><a href="/antid"><%= _t('nav_antid') %></a></li>
            <li><a href="/compatibility"><%= _t('nav_compatibility') %></a></li>
            <li><a href="/donation-guidelines"><%= _t('nav_guidelines') %></a></li>
            <li><a href="/faq"><%= _t('nav_faq') %></a></li>
          </ul>
        </div>

        <div class="col-lg-4">
          <h6 class="text-white fw-bold mb-3"><%= _t('foot_contact') %></h6>
          <ul class="list-unstyled d-grid gap-2" style="color:#94a3b8;">
            <li><i class="fas fa-envelope me-2 text-danger"></i><%= _s.site_email || 'info.bloodora@gmail.com' %></li>
            <li><i class="fas fa-phone me-2 text-danger"></i><%= _s.site_phone || '+8801709202140' %></li>
            <li><i class="fas fa-map-marker-alt me-2 text-danger"></i><%= _s.site_address || 'Kalai, Joypurhat, Bangladesh' %></li>
          </ul>
          <div class="mt-3 d-flex flex-wrap gap-2">
            <a href="/contact" class="btn btn-sm btn-outline-light rounded-pill" style="border-color:rgba(255,255,255,.2);"><i class="fas fa-headset me-1"></i><%= _t('chat_title') %></a>
          </div>
          <div class="small mt-3" style="color:#64748b;"><i class="fas fa-truck me-1"></i><%= _t('shop_delivery') %></div>
        </div>
      </div>

      <hr style="border-color:rgba(255,255,255,.08); margin:34px 0 20px;">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small" style="color:#64748b;">
        <div>© <%= new Date().getFullYear() %> <strong style="color:#94a3b8;"><%= _name %></strong> — <%= _t('foot_rights') %></div>
        <div class="d-flex gap-3 align-items-center flex-wrap">
          <a href="/contact" style="color:#64748b;"><%= _t('nav_contact') %></a>
          <span>•</span>
          <a href="/reviews" style="color:#64748b;"><%= _t('rev_title') %></a>
          <span>•</span>
          <span><%= _t('shop_delivery') %></span>
        </div>
      </div>
    </div>
  </footer>

  <!-- ================= Floating help widgets ================= -->
  <div id="bo-widgets" style="position:fixed; <%= _dir==='rtl'?'left:18px':'right:18px' %>; bottom:18px; z-index:1080; display:flex; flex-direction:column; <%= _dir==='rtl'?'align-items:flex-start':'align-items:flex-end' %>; gap:12px;">

    <!-- ---------- Live Messaging (real human support) ---------- -->
    <% if (_chatOn) { %>
    <div id="bo-chat-wrap" style="position:relative;">
      <button id="bo-chat-fab" class="widget-fab fab-chat" aria-label="<%= _t('chat_title') %>">
        <i class="fas fa-comments"></i>
        <span id="bo-chat-unread" class="unread-pill d-none">0</span>
      </button>
      <div id="bo-chat-panel" class="widget-panel d-none" style="<%= _dir==='rtl'?'left:0':'right:0' %>;">
        <div class="widget-head widget-head-chat">
          <div>
            <div class="fw-bold" style="font-family:var(--font-display); font-size:1.05rem;"><i class="fas fa-headset me-2"></i><%= _t('chat_title') %></div>
            <div class="small" style="opacity:.9;"><span id="bo-chat-status"><span class="live-dot"></span><%= _t('chat_online') %></span></div>
          </div>
          <button id="bo-chat-close" class="btn btn-sm" aria-label="<%= _t('common_close') %>" style="background:rgba(255,255,255,.2); border:none; color:#fff; width:32px; height:32px; border-radius:50%; padding:0;"><i class="fas fa-times"></i></button>
        </div>
        <div id="bo-chat-body" class="widget-body"></div>
        <div class="widget-foot">
          <div class="d-flex gap-2">
            <input id="bo-chat-input" class="form-control" placeholder="<%= _t('chat_placeholder') %>" style="border-radius:999px;" maxlength="2000">
            <button id="bo-chat-send" class="btn btn-danger" aria-label="<%= _t('chat_send') %>" style="border-radius:50%; width:42px; height:42px; padding:0; display:flex; align-items:center; justify-content:center;"><i class="fas fa-paper-plane"></i></button>
          </div>
          <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
            <span id="bo-chat-name"><%= _isLogged ? currentUser.name : 'Guest' %></span>
            <% if (_aiOn) { %><a href="#" id="bo-chat-to-ai" style="color:#4f46e5; font-weight:600;"><i class="fas fa-robot me-1"></i><%= _t('chat_ai') %></a><% } %>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- ---------- Live AI Help ---------- -->
    <% if (_aiOn) { %>
    <div id="bo-ai-wrap" style="position:relative;">
      <button id="bo-ai-fab" class="widget-fab fab-ai" aria-label="<%= _t('chat_ai_title') %>">
        <i class="fas fa-robot"></i>
      </button>
      <div id="bo-ai-panel" class="widget-panel d-none" style="<%= _dir==='rtl'?'left:0':'right:0' %>;">
        <div class="widget-head widget-head-ai">
          <div>
            <div class="fw-bold" style="font-family:var(--font-display); font-size:1.05rem;"><i class="fas fa-wand-magic-sparkles me-2"></i><%= _t('chat_ai_title') %></div>
            <div class="small" style="opacity:.92;"><span id="bo-ai-status"><span class="live-dot"></span><%= _t('chat_ai_status') %></span></div>
          </div>
          <div class="d-flex gap-1">
            <button id="bo-ai-reset" class="btn btn-sm" title="<%= _t('common_refresh') %>" aria-label="<%= _t('common_refresh') %>" style="background:rgba(255,255,255,.2); border:none; color:#fff; width:32px; height:32px; border-radius:50%; padding:0;"><i class="fas fa-rotate-right"></i></button>
            <button id="bo-ai-close" class="btn btn-sm" aria-label="<%= _t('common_close') %>" style="background:rgba(255,255,255,.2); border:none; color:#fff; width:32px; height:32px; border-radius:50%; padding:0;"><i class="fas fa-times"></i></button>
          </div>
        </div>
        <div class="widget-body" style="background:linear-gradient(180deg,#f5f3ff,#f8fafc);">
          <div class="small mb-2" style="color:#4c1d95;"><%= _t('chat_ai_sub') %></div>
          <div id="bo-ai-chips" class="d-flex flex-wrap gap-2 mb-3"></div>
          <div id="bo-ai-body"></div>
        </div>
        <div class="widget-foot">
          <div class="d-flex gap-2">
            <input id="bo-ai-input" class="form-control" placeholder="<%= _t('chat_placeholder') %>" style="border-radius:999px;" maxlength="4000">
            <button id="bo-ai-send" class="btn" aria-label="<%= _t('chat_send') %>" style="border-radius:50%; width:42px; height:42px; padding:0; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#4f46e5,#7c3aed); color:#fff;"><i class="fas fa-paper-plane"></i></button>
          </div>
          <% if (_chatOn) { %><div class="small text-muted mt-2 text-end"><a href="#" id="bo-ai-to-chat" style="color:var(--primary); font-weight:600;"><i class="fas fa-user-headset me-1"></i><%= _t('chat_human') %></a></div><% } %>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <!-- ================================================================= -->
  <!-- Shared utilities: stripThink (AI reasoning removal) + the id-keyed -->
  <!-- message store that makes live-chat deduplication exact. Same file  -->
  <!-- is exercised by the Node test-suite (test/frontend.test.mjs).      -->
  <script src="/js/chat-utils.js"></script>
  <script>
  (function(){
    var LANG = <%- JSON.stringify(_lang) %>;
    var I18N = {
      thinking: <%- JSON.stringify(_t('chat_thinking')) %>,
      you: <%- JSON.stringify(_t('chat_you')) %>,
      support: <%- JSON.stringify(_t('chat_support')) %>,
      offline: <%- JSON.stringify(_t('chat_offline')) %>,
      loading: <%- JSON.stringify(_t('common_loading')) %>,
      sending: <%- JSON.stringify(_t('chat_sending')) %>,
      failed: <%- JSON.stringify(_t('chat_failed')) %>,
      retry: <%- JSON.stringify(_t('common_retry')) %>,
      copy: <%- JSON.stringify(_t('chat_copy')) %>,
      copied: <%- JSON.stringify(_t('chat_copied')) %>,
      stopped: <%- JSON.stringify(_t('chat_stopped')) %>,
      newConv: <%- JSON.stringify(_t('chat_new')) %>,
      greeting: <%- JSON.stringify(_t('chat_ai_greeting')) %>,
      connected: <%- JSON.stringify(_t('chat_connected')) %>,
      connFail: <%- JSON.stringify(_t('chat_conn_fail')) %>,
      closed: <%- JSON.stringify(_t('chat_closed')) %>,
      online: <%- JSON.stringify(_t('chat_online')) %>,
      rateLimit: <%- JSON.stringify(_t('errors_ai_rate_limit')) %>,
      unavailable: <%- JSON.stringify(_t('errors_ai_unavailable')) %>,
      network: <%- JSON.stringify(_t('errors_ai_network')) %>,
      timeout: <%- JSON.stringify(_t('errors_ai_timeout')) %>,
      generic: <%- JSON.stringify(_t('errors_generic')) %>,
      statusReady: <%- JSON.stringify(_t('chat_ai_status')) %>
    };
    var stripThink = (window.BOSanitize && window.BOSanitize.stripThink) || function(t){ return t; };
    var createMessageStore = (window.BOSanitize && window.BOSanitize.createMessageStore) || function(){ var seen={}; return { accept:function(m){ if(!m) return false; if(m.id==null) return true; if(seen[m.id]) return false; seen[m.id]=1; return true; }, lastId:function(){ return 0; }, reset:function(){ seen={}; } }; };

    // ---- tiny markdown renderer: links + bold + line breaks, HTML-escaped first ----
    function esc(s){ return String(s).replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
    function md(text){
      var out = esc(text);
      out = out.replace(/\[([^\]]+)\]\((\/[^)\s]*)\)/g, function(_, label, href){
        return '<a href="' + href + '" data-bo-link>' + label + '</a>';
      });
      out = out.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      out = out.replace(/`([^`]+)`/g, '<code>$1</code>');
      out = out.replace(/\n/g, '<br>');
      return out;
    }
    // AI answers: reasoning is stripped from the RAW text first (never CSS-hidden),
    // then escaped+rendered. If nothing remains, show a retryable notice.
    function mdAi(text){
      var clean = stripThink(text);
      if (!clean) clean = '⚠️ ' + I18N.unavailable;
      return md(clean);
    }
    function bubble(cls, html){
      var d = document.createElement('div');
      d.className = 'chat-bubble ' + cls;
      d.innerHTML = html;
      return d;
    }
    function stamp(iso){
      try { var d = new Date(String(iso).includes('T') ? iso : iso.replace(' ', 'T') + 'Z'); return d.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}); }
      catch(e){ return ''; }
    }

    /* ============================== LIVE AI HELP ============================== */
    var aiState = { conv: null, busy: false, prompts: [], lastMessage: null, controller: null };
    var aiPanel = document.getElementById('bo-ai-panel');
    var aiBody  = document.getElementById('bo-ai-body');
    var aiInput = document.getElementById('bo-ai-input');
    var aiSendBtn = document.getElementById('bo-ai-send');

    function aiSay(text, cls){ if (aiBody) aiBody.appendChild(bubble(cls || 'msg-bot', cls === 'msg-bot' ? mdAi(text) : md(text))); aiScroll(); }
    function aiScroll(){ if (aiPanel) { var b = aiPanel.querySelector('.widget-body'); if (b) b.scrollTop = b.scrollHeight; } }

    // An AI answer bubble with copy + retry affordances (real actions, no fakes).
    function aiAnswer(text){
      if (!aiBody) return;
      var node = bubble('msg-bot', mdAi(text));
      var bar = document.createElement('div');
      bar.className = 'd-flex gap-2 mt-2';
      bar.style.cssText = 'opacity:.75;';
      var copyBtn = document.createElement('button');
      copyBtn.type = 'button'; copyBtn.className = 'btn btn-sm btn-light border';
      copyBtn.style.cssText = 'border-radius:999px; font-size:.68rem; padding:.1rem .55rem;';
      copyBtn.innerHTML = '<i class="fas fa-copy me-1"></i>' + esc(I18N.copy);
      copyBtn.onclick = function(){
        var clean = stripThink(text);
        if (navigator.clipboard) navigator.clipboard.writeText(clean).catch(function(){});
        copyBtn.innerHTML = '<i class="fas fa-check me-1"></i>' + esc(I18N.copied);
        setTimeout(function(){ copyBtn.innerHTML = '<i class="fas fa-copy me-1"></i>' + esc(I18N.copy); }, 1600);
      };
      var retryBtn = document.createElement('button');
      retryBtn.type = 'button'; retryBtn.className = 'btn btn-sm btn-light border';
      retryBtn.style.cssText = 'border-radius:999px; font-size:.68rem; padding:.1rem .55rem;';
      retryBtn.innerHTML = '<i class="fas fa-rotate-right me-1"></i>' + esc(I18N.retry);
      retryBtn.onclick = function(){ if (aiState.lastMessage && !aiState.busy) { aiInput.value = aiState.lastMessage; aiSend(); } };
      bar.appendChild(copyBtn); bar.appendChild(retryBtn);
      node.appendChild(bar);
      aiBody.appendChild(node);
      aiScroll();
    }

    function aiTyping(on){
      var el = document.getElementById('bo-ai-typing');
      if (on) {
        if (!el) { el = bubble('msg-bot', '<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>'); el.id = 'bo-ai-typing'; aiBody.appendChild(el); aiScroll(); }
      } else if (el) { el.remove(); }
    }

    function aiRenderChips(){
      var box = document.getElementById('bo-ai-chips');
      if (!box) return;
      box.innerHTML = '';
      aiState.prompts.forEach(function(p){
        var c = document.createElement('button');
        c.type = 'button'; c.className = 'chip'; c.textContent = p;
        c.onclick = function(){ if (!aiState.busy) { aiInput.value = p; aiSend(); } };
        box.appendChild(c);
      });
    }

    function aiSend(attemptCount){
      var text = (aiInput.value || '').trim();
      var isRetry = typeof attemptCount === 'number' && attemptCount > 0;
      if (!text && !isRetry) return;
      if (!isRetry) {
        aiInput.value = '';
        aiState.lastMessage = text;
        aiSay(text, 'msg-user');
      } else {
        text = aiState.lastMessage || text;
      }
      attemptCount = attemptCount || 0;

      aiState.busy = true;
      if (aiInput) aiInput.disabled = true;
      aiTyping(true);
      if (aiSendBtn) {
        aiSendBtn.innerHTML = '<i class="fas fa-stop"></i>';
        aiSendBtn.title = I18N.stopped;
      }
      aiState.controller = (typeof AbortController !== 'undefined') ? new AbortController() : null;

      fetch('/ai-help/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ message: text, conversation_id: aiState.conv, language: LANG }),
        signal: aiState.controller ? aiState.controller.signal : undefined
      })
      .then(function(r){
        if (r.status === 429 && attemptCount < 2) {
          // Exponential client backoff for rate limit
          return new Promise(function(resolve){
            setTimeout(function(){ resolve({ retry429: true }); }, (attemptCount + 1) * 1200);
          });
        }
        return r.json().catch(function(){
          return { success: false, status: r.status, message: r.status === 429 ? I18N.rateLimit : I18N.unavailable };
        });
      })
      .then(function(d){
        if (d && d.retry429) {
          return aiSend(attemptCount + 1);
        }
        aiTyping(false);
        if (d && d.success) {
          aiState.conv = d.conversation_id || aiState.conv;
          aiAnswer(d.reply);
        } else {
          var msg = (d && d.message) || I18N.unavailable;
          if (d && d.status === 429) msg = I18N.rateLimit;
          aiSay('⚠️ ' + msg, 'msg-bot');
        }
      })
      .catch(function(e){
        aiTyping(false);
        if (e && e.name === 'AbortError') {
          aiSay('⏹ ' + I18N.stopped, 'msg-bot');
        } else if (!navigator.onLine) {
          aiSay('⚠️ ' + I18N.network, 'msg-bot');
        } else {
          aiSay('⚠️ ' + I18N.unavailable, 'msg-bot');
        }
      })
      .finally(function(){
        if (!isRetry || attemptCount >= 2) {
          aiState.busy = false;
          aiState.controller = null;
          if (aiInput) {
            aiInput.disabled = false;
            aiInput.focus();
          }
          if (aiSendBtn) {
            aiSendBtn.innerHTML = '<i class="fas fa-paper-plane"></i>';
            aiSendBtn.title = '';
          }
        }
      });
    }

    function aiSendOrStop(){
      if (aiState.busy) {
        if (aiState.controller) aiState.controller.abort();
        return;
      }
      aiSend();
    }

    if (aiPanel) {
      var fab = document.getElementById('bo-ai-fab');
      if (fab) fab.onclick = function(){
        aiPanel.classList.toggle('d-none');
        if (!aiPanel.classList.contains('d-none') && aiInput) aiInput.focus();
      };
      var closeBtn = document.getElementById('bo-ai-close');
      if (closeBtn) closeBtn.onclick = function(){ aiPanel.classList.add('d-none'); };
      if (aiSendBtn) aiSendBtn.onclick = aiSendOrStop;
      if (aiInput) {
        aiInput.addEventListener('keydown', function(e){
          if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            aiSend();
          }
        });
      }
      var resetBtn = document.getElementById('bo-ai-reset');
      if (resetBtn) resetBtn.onclick = function(){
        if (aiState.busy && aiState.controller) aiState.controller.abort();
        aiState.conv = null;
        aiState.lastMessage = null;
        aiBody.innerHTML = '';
        aiSay('👋 ' + I18N.newConv, 'msg-bot');
        aiRenderChips();
      };
      var toChat = document.getElementById('bo-ai-to-chat');
      if (toChat) toChat.onclick = function(e){
        e.preventDefault();
        aiPanel.classList.add('d-none');
        var f = document.getElementById('bo-chat-fab');
        if (f) f.click();
      };
      fetch('/ai-help/config').then(function(r){ return r.json(); }).then(function(d){
        if (d && d.enabled === false && fab) { fab.style.opacity = .45; }
        aiState.prompts = (d && d.prompts) || [];
        aiRenderChips();
      }).catch(function(){});
      aiSay(I18N.greeting, 'msg-bot');
    }

    /* ============================== LIVE MESSAGING ==============================
     * Duplicate-message fix (root cause):
     *   The old code rendered an optimistic bubble with NO id tracking, then
     *   rendered the POST response message again — the `id <= lastId` guard
     *   passed because lastId never advanced for the optimistic copy — and the
     *   SSE stream could deliver it a third time.
     *   Now every server message flows through ONE id-keyed store (accept()
     *   returns true exactly once per id), and the optimistic bubble carries a
     *   temp id that is REPLACED by the canonical message when the POST
     *   responds. Order of arrival between POST response, SSE and polling no
     *   longer matters: each id renders once, ever.
     */
    var chatPanel = document.getElementById('bo-chat-panel');
    var chatBody  = document.getElementById('bo-chat-body');
    var chatInput = document.getElementById('bo-chat-input');
    var chatStore = createMessageStore();
    var chatState = { key: null, stream: null, poll: null, opened: false, unread: 0, tempSeq: 0 };

    function chatSay(html, cls){ if (chatBody) chatBody.appendChild(bubble(cls || 'msg-bot', html)); chatScroll(); }
    function chatScroll(){ if (chatPanel) { var b = chatPanel.querySelector('.widget-body'); if (b) b.scrollTop = b.scrollHeight; } }
    function bumpUnread(){
      chatState.unread++;
      var pill = document.getElementById('bo-chat-unread');
      if (pill) { pill.textContent = chatState.unread; pill.classList.remove('d-none'); }
    }
    function clearUnread(){
      chatState.unread = 0;
      var pill = document.getElementById('bo-chat-unread');
      if (pill) pill.classList.add('d-none');
    }

    // Render a SERVER message exactly once (POST response, SSE and polling all
    // come through here). Returns the node when it rendered something.
    function renderMsg(m){
      if (!chatStore.accept(m)) return null;      // duplicate id -> ignore
      var mine = m.sender_type === 'visitor';
      var who  = mine ? I18N.you : (m.sender_name || I18N.support);
      var node = bubble(mine ? 'msg-user' : 'msg-bot',
        '<div class="small fw-bold mb-1" style="opacity:.75;">' + esc(who) + ' · ' + stamp(m.created_at) + '</div>' + md(m.body));
      if (m.id != null) node.setAttribute('data-msg-id', m.id);
      if (chatBody) chatBody.appendChild(node);
      chatScroll();
      if (!mine && chatPanel && chatPanel.classList.contains('d-none')) bumpUnread();
      return node;
    }

    function chatOpenStream(){
      if (!chatState.key || typeof EventSource === 'undefined') return;
      if (chatState.stream) { try { chatState.stream.close(); } catch(e){} chatState.stream = null; } // exactly one subscription
      try {
        var es = new EventSource('/support/stream?session=' + encodeURIComponent(chatState.key));
        chatState.stream = es;
        es.addEventListener('message', function(ev){
          try {
            var d = JSON.parse(ev.data);
            if (d.type === 'message' && d.message) renderMsg(d.message);
            if (d.type === 'closed') chatSay('🔒 ' + I18N.closed, 'msg-bot');
          } catch(e){}
        });
        es.onerror = function(){ es.close(); chatState.stream = null; chatStartPolling(); };
      } catch(e){ chatStartPolling(); }
    }
    function chatStartPolling(){
      if (chatState.poll) return;
      chatState.poll = setInterval(function(){
        if (!chatState.key) return;
        fetch('/support/messages?session=' + encodeURIComponent(chatState.key) + '&after=' + chatStore.lastId())
          .then(function(r){ return r.json(); })
          .then(function(d){ (d.messages || []).forEach(renderMsg); })
          .catch(function(){});
      }, 6000);
    }

    function chatInit(){
      if (chatState.opened) return;
      chatState.opened = true;
      chatSay('<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>', 'msg-bot');
      fetch('/support/session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ session_key: localStorage.getItem('bo_chat_key') })
      })
      .then(function(r){ return r.json(); })
      .then(function(d){
        chatBody.innerHTML = '';
        chatStore.reset();                          // fresh conversation window
        if (d.greeting) chatSay('<strong>' + esc(I18N.support) + '</strong><br>' + md(d.greeting), 'msg-bot');
        chatState.key = d.session_key;
        localStorage.setItem('bo_chat_key', chatState.key);
        (d.messages || []).forEach(renderMsg);      // history: deduped by id
        document.getElementById('bo-chat-status').innerHTML = '<span class="live-dot"></span>' + esc(I18N.connected);
        chatOpenStream();
      })
      .catch(function(){
        chatBody.innerHTML = '';
        chatSay('⚠️ ' + I18N.connFail, 'msg-bot');
        chatState.opened = false;
      });
    }

    function chatSend(){
      var text = (chatInput.value || '').trim();
      if (!text) return;
      chatInput.value = '';

      // Optimistic bubble with a TEMP id (never compared by text).
      var tempId = 'tmp-' + (++chatState.tempSeq) + '-' + Date.now();
      var pending = bubble('msg-user',
        '<div class="small fw-bold mb-1" style="opacity:.75;">' + esc(I18N.you) + ' · ' + esc(I18N.sending) + '</div>' + md(text));
      pending.setAttribute('data-temp-id', tempId);
      pending.style.opacity = '.72';
      if (chatBody) chatBody.appendChild(pending);
      chatScroll();

      function reconcile(serverMsg){
        // The server accepted the message. If its id is new, upgrade the
        // optimistic bubble in place (one node, now canonical). If the SSE or
        // polling channel already rendered this id, drop the optimistic copy —
        // exactly one canonical node either way.
        if (serverMsg && chatStore.accept(serverMsg)) {
          var mine = true;
          pending.innerHTML = '<div class="small fw-bold mb-1" style="opacity:.75;">' + esc(I18N.you) + ' · ' + stamp(serverMsg.created_at) + '</div>' + md(serverMsg.body);
          pending.setAttribute('data-msg-id', serverMsg.id);
        } else {
          pending.remove();
        }
        pending.style.opacity = '';
      }

      fetch('/support/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ session_key: chatState.key, body: text })
      })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if (d && d.success && d.message) { reconcile(d.message); }
        else {
          pending.innerHTML = '<div class="small fw-bold mb-1" style="opacity:.75;">' + esc(I18N.you) + '</div>' + md(text) +
            '<div class="small mt-1"><i class="fas fa-triangle-exclamation me-1"></i>' + esc((d && d.message) || I18N.failed) + '</div>';
          pending.style.opacity = '';
        }
      })
      .catch(function(){
        pending.innerHTML = '<div class="small fw-bold mb-1" style="opacity:.75;">' + esc(I18N.you) + '</div>' + md(text) +
          '<div class="small mt-1"><i class="fas fa-triangle-exclamation me-1"></i>' + esc(I18N.failed) +
          ' <button type="button" class="btn btn-sm btn-light border" style="border-radius:999px; font-size:.66rem; padding:0 .5rem;" data-bo-retry>' + esc(I18N.retry) + '</button></div>';
        pending.style.opacity = '';
        var rb = pending.querySelector('[data-bo-retry]');
        if (rb) rb.onclick = function(){ pending.remove(); chatInput.value = text; chatSend(); };
      });
    }

    if (chatPanel) {
      document.getElementById('bo-chat-fab').onclick = function(){
        chatPanel.classList.toggle('d-none');
        if (!chatPanel.classList.contains('d-none')) { clearUnread(); chatInit(); chatInput.focus(); }
      };
      document.getElementById('bo-chat-close').onclick = function(){ chatPanel.classList.add('d-none'); };
      document.getElementById('bo-chat-send').onclick = chatSend;
      chatInput.addEventListener('keydown', function(e){ if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); chatSend(); } });
      var toAi = document.getElementById('bo-chat-to-ai');
      if (toAi) toAi.onclick = function(e){ e.preventDefault(); chatPanel.classList.add('d-none'); var f = document.getElementById('bo-ai-fab'); if (f) f.click(); };
      // keep the unread badge accurate even when the panel is closed (single
      // interval; the id-keyed store makes its renders duplicate-proof)
      setInterval(function(){
        if (!chatState.key || !chatPanel.classList.contains('d-none')) return;
        fetch('/support/messages?session=' + encodeURIComponent(chatState.key) + '&after=' + chatStore.lastId())
          .then(function(r){ return r.json(); })
          .then(function(d){ (d.messages || []).forEach(renderMsg); })
          .catch(function(){});
      }, 15000);
    }

    // Anywhere an AI answer links to a page, keep the click inside the site.
    document.addEventListener('click', function(e){
      var a = e.target.closest && e.target.closest('[data-bo-link]');
      if (a) { document.querySelectorAll('.widget-panel').forEach(function(p){ p.classList.add('d-none'); }); }
    });
  })();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Auto-dismiss flash messages after 4.5s
    setTimeout(function(){
      document.querySelectorAll('.alert-dismissible').forEach(function(a){
        try { bootstrap.Alert.getOrCreateInstance(a).close(); } catch(e) { a.remove(); }
      });
    }, 4500);
    // Notification bell: real unread count from the backend (logged-in only).
    // Cached in sessionStorage so page-to-page navigation does not re-hit the
    // API on every view; the messages page refreshes the cached value.
    (function(){
      var pill = document.getElementById('bo-unread-pill');
      if (!pill) return; // not logged in
      function paint(n){
        n = Number(n) || 0;
        if (n > 0) { pill.textContent = n > 99 ? '99+' : n; pill.classList.remove('d-none'); }
        else { pill.classList.add('d-none'); }
      }
      try {
        var cached = sessionStorage.getItem('bo_unread');
        if (cached !== null) paint(cached);
      } catch(e){}
      fetch('/api/notifications/unread', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function(r){ return r.ok ? r.json() : null; })
        .then(function(d){
          if (!d || !d.success) return;
          try { sessionStorage.setItem('bo_unread', d.unread); } catch(e){}
          paint(d.unread);
        })
        .catch(function(){});
    })();
  </script>
</body>
</html>
