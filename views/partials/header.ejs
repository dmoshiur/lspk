<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'BloodOra - Blood Donation Network' %></title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" href="/logo.png">
  <!-- Fonts: Inter for ultra crisp retina text + Bengali support -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <style>
    :root{
      --primary:#e31b23; --primary-dark:#c41219; --primary-soft:#fff0f0;
      --secondary:#0f172a; --muted:#64748b; --light:#f8fafc; --surface:#ffffff;
      --border:#e2e8f0; --radius:16px; --radius-lg:22px;
      --shadow:0 4px 24px rgba(15,23,42,.06); --shadow-lg:0 12px 40px rgba(15,23,42,.12);
      --ring:0 0 0 4px rgba(227,27,35,.12);
    }
    *{ -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale; text-rendering:optimizeLegibility; }
    body{
      font-family:'Inter','Hind Siliguri',system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
      background:linear-gradient(180deg,#f8fafc 0%, #f1f5f9 100%);
      color:var(--secondary);
      line-height:1.6;
      overflow-x:hidden;
    }
    /* Navbar - Glass Ultra Clean */
    .navbar{
      background:rgba(255,255,255,.92) !important;
      backdrop-filter:blur(16px) saturate(180%);
      -webkit-backdrop-filter:blur(16px) saturate(180%);
      box-shadow:0 1px 0 rgba(15,23,42,.06), 0 8px 32px rgba(15,23,42,.04);
      padding:.65rem 0;
      border-bottom:1px solid rgba(226,232,240,.8);
    }
    .navbar-brand{
      font-weight:800; letter-spacing:-.02em; color:var(--primary)!important;
      font-size:1.55rem; gap:.6rem;
    }
    .navbar-brand img{ height:42px; width:auto; object-fit:contain; filter:drop-shadow(0 2px 8px rgba(227,27,35,.18)); }
    .nav-link{
      font-weight:600; font-size:.92rem; color:#334155 !important;
      padding:.55rem .95rem !important; border-radius:999px; transition:all .2s;
      display:inline-flex; align-items:center; gap:.45rem;
    }
    .nav-link:hover{ background:var(--primary-soft); color:var(--primary)!important; transform:translateY(-1px); }
    .nav-link.active{ background:var(--primary); color:#fff!important; box-shadow:0 8px 20px rgba(227,27,35,.25); }
    .navbar-toggler{ border:none; box-shadow:none!important; }
    /* Buttons Ultra */
    .btn{ border-radius:999px; font-weight:700; letter-spacing:-.01em; padding:.68rem 1.35rem; transition:all .2s; }
    .btn-danger{ background:linear-gradient(135deg,var(--primary),#ff3340); border:none; box-shadow:0 8px 20px rgba(227,27,35,.28); }
    .btn-danger:hover{ background:linear-gradient(135deg,var(--primary-dark),var(--primary)); transform:translateY(-2px); box-shadow:0 12px 28px rgba(227,27,35,.35); }
    .btn-outline-danger{ border:2px solid rgba(227,27,35,.18); color:var(--primary); background:#fff; }
    .btn-outline-danger:hover{ background:var(--primary); border-color:var(--primary); color:#fff; transform:translateY(-1px); }
    .btn-light{ background:#fff; border:1px solid var(--border); color:var(--secondary); box-shadow:var(--shadow); }
    .btn-light:hover{ background:#f8fafc; transform:translateY(-1px); }
    /* Cards Ultra */
    .card{ border:1px solid rgba(226,232,240,.9); border-radius:var(--radius); background:var(--surface); box-shadow:var(--shadow); overflow:hidden; transition:all .25s; }
    .card:hover{ transform:translateY(-4px); box-shadow:var(--shadow-lg); border-color:rgba(227,27,35,.08); }
    /* Hero Ultra */
    .hero-section{
      background:
        radial-gradient(1200px 600px at 10% -20%, rgba(255,255,255,.18), transparent 60%),
        radial-gradient(900px 500px at 90% 0%, rgba(255,51,64,.35), transparent 60%),
        linear-gradient(135deg, #d90f16 0%, #e31b23 45%, #ff3b46 100%);
      color:#fff; padding:84px 0 64px; position:relative; overflow:hidden; margin-bottom:36px;
    }
    .hero-section::after{
      content:""; position:absolute; inset:0;
      background:linear-gradient(180deg, transparent, rgba(0,0,0,.06));
      pointer-events:none;
    }
    .hero-section h1{ font-weight:800; font-size:clamp(28px,4.2vw,44px); letter-spacing:-.03em; line-height:1.05; text-shadow:0 2px 20px rgba(0,0,0,.15); }
    .hero-section .lead{ font-weight:500; opacity:.95; font-size:1.15rem; }
    /* Stats */
    .stat-card{ background:rgba(255,255,255,.96); border:1px solid rgba(226,232,240,.9); border-radius:var(--radius-lg); padding:22px; text-align:center; box-shadow:var(--shadow); transition:all .25s; backdrop-filter:blur(8px); }
    .stat-card:hover{ transform:translateY(-4px); box-shadow:var(--shadow-lg); }
    .stat-card h3{ color:var(--primary); font-size:2.15rem; font-weight:800; letter-spacing:-.03em; margin-bottom:4px; }
    .stat-card p{ color:var(--muted); font-weight:600; font-size:.92rem; margin:0; }
    /* Process */
    .process-step{ background:#fff; border-radius:var(--radius-lg); padding:26px; text-align:center; box-shadow:var(--shadow); border:1px solid rgba(226,232,240,.9); height:100%; transition:all .25s; }
    .process-step:hover{ transform:translateY(-4px); box-shadow:var(--shadow-lg); }
    .step-number{ background:linear-gradient(135deg,var(--primary),#ff3340); color:#fff; width:46px; height:46px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-weight:800; margin-bottom:14px; box-shadow:0 8px 20px rgba(227,27,35,.3); }
    /* Footer Ultra */
    .footer{ background:linear-gradient(180deg,#0f172a 0%, #0b1220 100%); color:#cbd5e1; padding:56px 0 28px; margin-top:64px; border-top:1px solid rgba(255,255,255,.06); }
    .footer a{ color:#94a3b8; text-decoration:none; transition:color .2s; }
    .footer a:hover{ color:#fff; }
    .footer h5{ color:#fff; font-weight:800; letter-spacing:-.02em; }
    .social-icons a{ display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; border-radius:50%; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.08); margin-right:10px; transition:all .2s; }
    .social-icons a:hover{ background:var(--primary); border-color:var(--primary); color:#fff; transform:translateY(-2px); }
    /* Forms Ultra */
    .form-control,.form-select{ border-radius:12px; padding:.72rem 1rem; border:1.5px solid var(--border); background:#fff; font-weight:500; transition:all .2s; }
    .form-control:focus,.form-select:focus{ border-color:var(--primary); box-shadow:var(--ring); outline:none; }
    .form-label{ font-weight:700; font-size:.9rem; color:#334155; letter-spacing:-.01em; }
    /* Badge */
    .badge{ border-radius:999px; padding:.45em .85em; font-weight:700; letter-spacing:.01em; }
    /* Alerts */
    .alert{ border-radius:14px; border:none; box-shadow:var(--shadow); font-weight:500; }
    /* Table */
    .table{ --bs-table-bg:transparent; }
    .table thead th{ background:#f8fafc; color:#334155; font-weight:800; font-size:.82rem; letter-spacing:.04em; text-transform:uppercase; border-bottom:1.5px solid var(--border); }
    /* Chat widget */
    #chat-open-btn:hover{ transform:scale(1.08) rotate(3deg); }
    .chat-bubble{ max-width:85%; margin-bottom:12px; padding:12px 16px; border-radius:18px; font-size:.92rem; animation:fadeIn .3s ease; }
    @keyframes fadeIn{ from{ opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;}}
    .msg-user{ background:linear-gradient(135deg,var(--primary),#ff3340); color:#fff; border-bottom-right-radius:6px; box-shadow:0 8px 20px rgba(227,27,35,.2); margin-left:auto; }
    .msg-admin{ background:#fff; color:#0f172a; border:1px solid var(--border); border-bottom-left-radius:6px; box-shadow:var(--shadow); }
    /* Retina image crisp */
    img{ image-rendering:-webkit-optimize-contrast; }
    /* Utility */
    .text-primary{ color:var(--primary)!important; }
    .bg-primary{ background:var(--primary)!important; }
    .rounded-4{ border-radius:var(--radius)!important; }
    @media (max-width:991px){
      .navbar-brand img{ height:36px; }
      .hero-section{ padding:48px 0 36px; }
    }
  </style>
  <% if (typeof extraCss !== 'undefined') { %><%- extraCss %><% } %>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg sticky-top">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center" href="/">
        <img src="/logo.png" alt="BloodOra" onerror="this.style.display='none'">BloodOra
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMain">
        <ul class="navbar-nav me-auto align-items-lg-center">
          <li class="nav-item"><a class="nav-link" href="/"><i class="fas fa-home"></i>Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/donors"><i class="fas fa-users"></i>Donors</a></li>
          <li class="nav-item"><a class="nav-link" href="/blood-requests"><i class="fas fa-tint"></i>Blood Requests</a></li>
          <li class="nav-item"><a class="nav-link" href="/request-blood"><i class="fas fa-plus-circle"></i>Request Blood</a></li>
          <li class="nav-item"><a class="nav-link" href="/shop"><i class="fas fa-shopping-bag"></i>Shop</a></li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="fas fa-book-medical"></i>Resources</a>
            <ul class="dropdown-menu shadow border-0 rounded-4 p-2">
              <li><a class="dropdown-item rounded-3" href="/antid"><i class="fas fa-syringe me-2 text-danger"></i>Anti-D Information</a></li>
              <li><a class="dropdown-item rounded-3" href="/resources"><i class="fas fa-graduation-cap me-2 text-danger"></i>Educational Resources</a></li>
              <li><a class="dropdown-item rounded-3" href="/donation-guidelines"><i class="fas fa-clipboard-list me-2 text-danger"></i>Donation Guidelines</a></li>
              <li><a class="dropdown-item rounded-3" href="/faq"><i class="fas fa-question-circle me-2 text-danger"></i>FAQ</a></li>
              <li><a class="dropdown-item rounded-3" href="/contact"><i class="fas fa-envelope me-2 text-danger"></i>Contact Us</a></li>
            </ul>
          </li>
          <li class="nav-item"><a class="nav-link" href="/compatibility"><i class="fas fa-vial"></i>Compatibility</a></li>
        </ul>
        <ul class="navbar-nav align-items-lg-center gap-1">
          <li class="nav-item me-2">
            <a class="nav-link position-relative" href="/shop/cart">
              <i class="fas fa-shopping-cart"></i>Cart
              <% if (typeof cartCount !== 'undefined' && cartCount>0) { %><span class="badge bg-danger ms-1"><%= cartCount %></span><% } else if (typeof sessionCartCount !== 'undefined' && sessionCartCount>0) { %><span class="badge bg-danger ms-1"><%= sessionCartCount %></span><% } %>
            </a>
          </li>
          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <% if (currentUser.is_admin) { %>
              <li class="nav-item"><a class="nav-link" href="/admin"><i class="fas fa-cog"></i>Admin</a></li>
            <% } %>
            <li class="nav-item"><a class="nav-link" href="/shop/my-orders"><i class="fas fa-box"></i>My Orders</a></li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown" style="background:#fff; border:1px solid var(--border); border-radius:999px; padding:.35rem .9rem .35rem .45rem !important;">
                <% if (currentUser.image_file && currentUser.image_file !== 'default.jpg') { %>
                  <img src="/uploads/<%= currentUser.image_file %>" alt="Profile" style="width:32px;height:32px;border-radius:50%;object-fit:cover;">
                <% } else { %>
                  <img src="https://ui-avatars.com/api/?background=e31b23&color=fff&name=<%= encodeURIComponent(currentUser.name) %>&size=64&bold=true" alt="Profile" style="width:32px;height:32px;border-radius:50%;object-fit:cover;">
                <% } %>
                <span class="d-none d-lg-inline fw-bold" style="max-width:110px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= currentUser.name.split(' ')[0] %></span>
              </a>
              <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-2" style="min-width:220px;">
                <li><a class="dropdown-item rounded-3" href="/donors/profile/my"><i class="fas fa-user me-2 text-danger"></i>My Profile</a></li>
                <li><a class="dropdown-item rounded-3" href="/messages"><i class="fas fa-envelope me-2 text-danger"></i>Messages</a></li>
                <li><a class="dropdown-item rounded-3" href="/donors/profile/edit"><i class="fas fa-edit me-2 text-danger"></i>Edit Profile</a></li>
                <% if (!currentUser.is_verified && currentUser.age && currentUser.age>=18) { %>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <form method="POST" action="/donors/apply-for-verification" class="px-2">
                      <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-pill"><i class="fas fa-check-circle me-1"></i>Apply for Verification</button>
                    </form>
                  </li>
                <% } %>
                <% if (typeof session !== 'undefined' && session && session.impersonating) { %>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item rounded-3 text-warning fw-bold" href="/profile/switch-back"><i class="fas fa-undo me-2"></i>Switch back to Admin</a></li>
                <% } %>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item rounded-3" href="/logout"><i class="fas fa-sign-out-alt me-2 text-danger"></i>Logout</a></li>
              </ul>
            </li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/login"><i class="fas fa-sign-in-alt"></i>Login</a></li>
            <li class="nav-item ms-1"><a class="btn btn-danger btn-sm px-4" href="/register">Register</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Flash Messages -->
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="container mt-3">
      <div class="alert alert-<%= flash.type==='danger'?'danger':flash.type==='success'?'success':flash.type==='warning'?'warning':'info' %> alert-dismissible fade show shadow-sm border-0" role="alert" style="border-radius:14px;">
        <i class="fas fa-<%= flash.type==='success'?'check-circle':flash.type==='danger'?'exclamation-triangle':flash.type==='warning'?'exclamation-circle':'info-circle' %> me-2"></i>
        <%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    </div>
  <% } %>
