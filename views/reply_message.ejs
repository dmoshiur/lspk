<%- include('partials/header') %>
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-lg p-4" style="border-radius:22px;">
        <h4 class="fw-bold mb-3">Reply to: <%= original.subject %></h4>
        <div class="p-3 rounded-4 mb-3" style="background:#f8fafc; border:1px solid #e2e8f0;">
          <div class="small text-muted">Original from <%= original.sender_name||('User #'+original.sender_id) %></div>
          <div class="small" style="white-space:pre-wrap;"><%= original.content %></div>
        </div>
        <form method="POST">
          <div class="mb-3"><label class="form-label">Your Reply</label><textarea name="content" class="form-control" rows="5" required placeholder="Type reply..."></textarea></div>
          <div class="d-flex gap-2"><a href="/messages" class="btn btn-light border rounded-pill">Cancel</a><button class="btn btn-danger rounded-pill"><i class="fas fa-paper-plane me-1"></i>Send Reply</button></div>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
