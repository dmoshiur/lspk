<%
  // Shared error layout used by 400 / 403 / 404 / 500.
  // Locals: errCode, errIcon, errTitle, errBody, errHint (optional), errActions (optional array)
  const _t    = (typeof t === 'function') ? t : (k) => k;
  const _b    = (typeof branding !== 'undefined' && branding) ? branding : {};
  const _p    = _b.brand_primary || '#e31b23';
  const _code = (typeof errCode !== 'undefined') ? errCode : 500;
  const _icon = (typeof errIcon !== 'undefined') ? errIcon : 'fa-triangle-exclamation';
  const _title= (typeof errTitle !== 'undefined') ? errTitle : _t('err_500_title');
  const _body = (typeof errBody !== 'undefined') ? errBody : _t('err_500_body');
  const _hint = (typeof errHint !== 'undefined') ? errHint : '';
  const _req  = (typeof errRequest !== 'undefined') ? errRequest : '';
  const _detail = (typeof errDetail !== 'undefined') ? errDetail : '';
  const _quick = [
    ['/', 'fa-home', _t('err_home')],
    ['/shop', 'fa-shopping-bag', _t('err_shop')],
    ['/donors', 'fa-users', _t('nav_donors')],
    ['/blood-requests', 'fa-tint', _t('nav_requests')],
    ['/antid', 'fa-syringe', _t('nav_antid')],
    ['/reviews', 'fa-star', _t('nav_reviews')],
  ];
%>
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-lg overflow-hidden" style="border-radius:24px;">
        <div style="background:linear-gradient(135deg, <%= _p %> 0%, color-mix(in srgb, <%= _p %> 70%, #ff8a00) 100%); padding:44px 30px 56px; text-align:center; color:#fff; position:relative; overflow:hidden;">
          <div style="position:absolute; inset:0; background:radial-gradient(600px 260px at 50% 0%, rgba(255,255,255,.22), transparent 65%);"></div>
          <div class="position-relative">
            <div class="d-inline-flex align-items-center justify-content-center mb-3" style="width:96px;height:96px;border-radius:50%; background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.28); backdrop-filter:blur(8px); font-size:36px;">
              <i class="fas <%= _icon %>"></i>
            </div>
            <div class="script-accent" style="font-size:5.2rem; line-height:.9; opacity:.95; text-shadow:0 4px 22px rgba(0,0,0,.18);"><%= _code %></div>
            <h1 class="mt-2 mb-0" style="font-size:1.7rem; color:#fff;"><%= _title %></h1>
          </div>
        </div>

        <div class="card-body p-4 p-md-5" style="margin-top:-30px;">
          <div class="bg-white rounded-4 p-4 shadow-sm" style="border:1px solid #e2e8f0;">
            <p class="mb-0" style="font-size:1rem; line-height:1.7;"><%= _body %></p>

            <% if (_hint) { %>
              <div class="alert alert-info border-0 mt-3 mb-0 rounded-3 d-flex align-items-start gap-2">
                <i class="fas fa-lightbulb text-warning mt-1"></i><span><%= _hint %></span>
              </div>
            <% } %>

            <% if (_detail) { %>
              <div class="mt-3">
                <div class="eyebrow mb-1">Diagnostics</div>
                <code class="d-block p-2 rounded-3 text-danger" style="background:#fff0f0; border:1px solid #fecdd3; font-size:.76rem; word-break:break-word;"><%= _detail %></code>
              </div>
            <% } %>
            <% if (_req) { %>
              <div class="mt-2 small text-muted"><i class="fas fa-link me-1"></i>Requested: <code><%= _req %></code></div>
            <% } %>

            <div class="d-flex flex-wrap gap-2 mt-4">
              <a href="/" class="btn btn-danger"><i class="fas fa-home me-1"></i><%= _t('err_home') %></a>
              <a href="/shop" class="btn btn-light border"><i class="fas fa-shopping-bag me-1"></i><%= _t('err_shop') %></a>
              <% if (_code === 403) { %><a href="/login" class="btn btn-outline-danger"><i class="fas fa-sign-in-alt me-1"></i><%= _t('err_login') %></a><% } %>
              <% if (_code === 500) { %><button class="btn btn-outline-danger" onclick="location.reload()"><i class="fas fa-rotate me-1"></i><%= _t('common_retry') %></button><% } %>
              <% if ((typeof branding === 'undefined') || branding.ai_enabled !== false) { %>
                <button class="btn btn-outline-primary" style="border-color:#c7d2fe; color:#4338ca;" onclick="document.getElementById('bo-ai-fab')?.click()"><i class="fas fa-robot me-1"></i><%= _t('err_ai') %></button>
              <% } %>
            </div>
          </div>

          <div class="mt-4">
            <div class="eyebrow mb-2"><%= _t('err_what') %></div>
            <div class="row g-2">
              <% _quick.forEach(function(q){ %>
                <div class="col-6 col-md-4">
                  <a href="<%= q[0] %>" class="d-flex align-items-center gap-2 p-3 rounded-4 text-decoration-none" style="background:#fff; border:1px solid #e2e8f0; color:#0f172a; transition:all .2s;" onmouseover="this.style.borderColor='<%= _p %>'" onmouseout="this.style.borderColor='#e2e8f0'">
                    <i class="fas <%= q[1] %> text-danger"></i><span class="small fw-bold"><%= q[2] %></span>
                  </a>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
