<%- include('../partials/header') %>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold mb-0"><i class="fas fa-receipt text-danger me-2"></i>Manage Orders</h2>
    <a href="/admin" class="btn btn-light border btn-sm rounded-pill"><i class="fas fa-arrow-left me-1"></i>Admin</a>
  </div>
  <div class="d-flex gap-2 mb-3 flex-wrap">
    <a href="/shop/admin/orders" class="btn btn-sm <%= !filter?'btn-danger':'btn-outline-danger' %> rounded-pill">All</a>
    <a href="/shop/admin/orders?status=pending" class="btn btn-sm <%= filter==='pending'?'btn-warning':'btn-outline-warning' %> rounded-pill">Pending</a>
    <a href="/shop/admin/orders?status=processing" class="btn btn-sm <%= filter==='processing'?'btn-info':'btn-outline-info' %> rounded-pill">Processing</a>
    <a href="/shop/admin/orders?status=completed" class="btn btn-sm <%= filter==='completed'?'btn-success':'btn-outline-success' %> rounded-pill">Completed</a>
  </div>
  <% if (orders && orders.length){ %>
    <div class="card border-0 shadow-sm" style="border-radius:18px;">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead><tr><th>Order ID</th><th>Customer</th><th>Total</th><th>Payment</th><th>Status</th><th>Date</th><th>View</th></tr></thead>
          <tbody>
            <% orders.forEach(o=>{ %>
              <tr>
                <td class="fw-bold">#<%= o.id %></td>
                <td><%= o.user_name|| o.guest_name||'Guest' %></td>
                <td class="fw-bold" style="color:var(--primary);">৳<%= o.total_amount %></td>
                <td><span class="badge <%= o.payment_status==='confirmed'?'bg-success':'bg-warning text-dark' %>"><%= o.payment_method||'—' %></span><div class="small text-muted"><%= o.payment_status %></div></td>
                <td><% if(o.status==='pending'){ %><span class="badge bg-warning text-dark">Pending</span><% } else if(o.status==='processing'){ %><span class="badge bg-info">Processing</span><% } else if(o.status==='completed'){ %><span class="badge bg-success">Completed</span><% } else { %><span class="badge bg-secondary"><%= o.status %></span><% } %></td>
                <td class="small text-muted"><%= o.created_at? o.created_at.slice(0,10):'' %></td>
                <td><a href="/shop/admin/order/<%= o.id %>" class="btn btn-sm btn-outline-danger rounded-pill"><i class="fas fa-eye"></i></a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="card border-0 shadow-sm text-center p-5" style="border-radius:18px;"><i class="fas fa-cart-shopping fa-3x mb-3" style="color:#94a3b8;"></i><h5>No orders</h5></div>
  <% } %>
</div>
<%- include('../partials/footer') %>
