<%- include('../partials/header') %>
<%
  const _ss = (typeof sessions !== 'undefined' && sessions) ? sessions : [];
  // EJS's escaped output tag escapes exactly once. The old local escaper ran on
  // top of it and leaked literal &#39; / &amp; sequences into the rendered page.
%>

<div class="container mt-4 mb-5">
  <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
      <h2 class="fw-bold mb-0"><i class="fas fa-comments text-danger me-2"></i><%= t('lc_title') %></h2>
      <small class="text-muted"><%= t('lc_sub') %></small>
    </div>
    <div class="d-flex gap-2 align-items-center">
      <span class="badge bg-success rounded-pill" id="lc-status"><span class="live-dot" style="background:#fff;"></span><%= t('lc_connecting') %></span>
      <span class="badge bg-danger rounded-pill" id="lc-unread"><%= (typeof unread !== 'undefined' ? unread : 0) %> <%= t('msg_unread') %></span>
    </div>
  </div>

  <div class="admin-wrapper">
    <%- include('_sidebar', { active: 'livechat', stats: {} }) %>

    <main class="flex-grow-1" style="min-width:0;">
      <div class="row g-3">
        <!-- Conversation list -->
        <div class="col-lg-4">
          <div class="card border-0 shadow-sm" style="border-radius:20px;">
            <div class="card-body p-3">
              <div class="input-group input-group-sm mb-2">
                <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                <input id="lc-filter" class="form-control" placeholder="<%= t('lc_filter_ph') %>">
              </div>
              <div id="lc-list" class="d-grid gap-2" style="max-height:64vh; overflow-y:auto;">
                <% if (!_ss.length) { %><div class="alert alert-light border small text-center mb-0 rounded-3"><%= t('lc_empty') %></div><% } %>
                <% _ss.forEach(function(s){ %>
                  <button type="button" class="btn btn-light border text-start p-3 rounded-4 lc-item" data-key="<%= s.session_key %>" data-name="<%= s.visitor_name %>">
                    <div class="d-flex justify-content-between align-items-center">
                      <span class="fw-bold"><%= s.visitor_name || 'Guest' %></span>
                      <% if (s.online) { %><span class="badge bg-success">online</span><% } %>
                      <% if (s.unread_admin) { %><span class="badge bg-danger"><%= s.unread_admin %></span><% } %>
                    </div>
                    <div class="small text-muted text-truncate"><%= s.last_message || 'No messages yet' %></div>
                    <div class="small text-muted"><%= String(s.last_message_at||'').slice(0,16).replace('T',' ') %></div>
                  </button>
                <% }) %>
              </div>
            </div>
          </div>
        </div>

        <!-- Conversation window -->
        <div class="col-lg-8">
          <div class="card border-0 shadow-sm" style="border-radius:20px; overflow:hidden;">
            <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
              <div>
                <h6 class="fw-bold mb-0" id="lc-title"><%= t('lc_select') %></h6>
                <small class="text-muted" id="lc-sub">Messages stream live over server-sent events</small>
              </div>
              <button class="btn btn-sm btn-light border rounded-pill d-none" id="lc-close"><i class="fas fa-door-closed me-1"></i><%= t('lc_close') %></button>
            </div>
            <div class="card-body p-4" id="lc-body" style="height:52vh; overflow-y:auto; background:#f8fafc;">
              <div class="text-center text-muted small py-5"><i class="fas fa-hand-pointer fa-2x d-block mb-2"></i><%= t('lc_pick') %></div>
            </div>
            <div class="card-footer bg-white border-top p-3">
              <div class="d-flex gap-2">
                <input id="lc-input" class="form-control" placeholder="<%= t('chat_typing_ph') %>" disabled>
                <button class="btn btn-danger" id="lc-send" disabled><i class="fas fa-paper-plane me-1"></i><%= t('chat_send') %></button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<script>
(function(){
  var LC_I18N = {
    unread: <%- JSON.stringify(t('msg_unread')) %>,
    noMessages: <%- JSON.stringify(t('lc_no_messages')) %>,
    live: <%- JSON.stringify(t('lc_live')) %>,
    polling: <%- JSON.stringify(t('lc_polling')) %>
  };
  var current = null, lastId = 0, stream = null, poll = null;
  var body = document.getElementById('lc-body');
  var input = document.getElementById('lc-input');
  var sendBtn = document.getElementById('lc-send');

  function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
  function stamp(iso){ try { var d = new Date(String(iso).includes('T') ? iso : String(iso).replace(' ','T')+'Z'); return d.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}); } catch(e){ return ''; } }
  function render(m){
    if (m.id && m.id <= lastId) return;
    if (m.id) lastId = m.id;
    var admin = m.sender_type === 'admin';
    var d = document.createElement('div');
    d.className = 'chat-bubble ' + (admin ? 'msg-user' : 'msg-bot');
    d.innerHTML = '<div class="small fw-bold mb-1" style="opacity:.75;">' + esc(m.sender_name || (admin ? 'Admin' : 'Visitor')) + ' · ' + stamp(m.created_at) + '</div>' + esc(m.body).replace(/\n/g,'<br>');
    body.appendChild(d);
    body.scrollTop = body.scrollHeight;
  }

  function open(key, name){
    current = key; lastId = 0;
    body.innerHTML = '';
    document.getElementById('lc-title').textContent = name || 'Visitor';
    document.getElementById('lc-close').classList.remove('d-none');
    input.disabled = false; sendBtn.disabled = false;
    document.querySelectorAll('.lc-item').forEach(function(b){ b.classList.toggle('btn-danger', b.dataset.key === key); b.classList.toggle('text-white', b.dataset.key === key); });
    fetch('/support/admin/sessions/' + encodeURIComponent(key) + '/messages')
      .then(function(r){ return r.json(); })
      .then(function(d){
        body.innerHTML = ''; lastId = 0;
        (d.messages || []).forEach(render);
        if (!(d.messages || []).length) body.innerHTML = '<div class="text-center text-muted small py-4">' + esc(LC_I18N.noMessages) + '</div>';
      });
  }

  function send(){
    var text = (input.value || '').trim();
    if (!text || !current) return;
    input.value = '';
    fetch('/support/admin/sessions/' + encodeURIComponent(current) + '/reply', {
      method: 'POST', headers: { 'Content-Type':'application/json', 'X-Requested-With':'XMLHttpRequest' },
      body: JSON.stringify({ body: text })
    }).then(function(r){ return r.json(); }).then(function(d){ if (d.success && d.message) render(d.message); });
  }
  sendBtn.addEventListener('click', send);
  input.addEventListener('keydown', function(e){ if (e.key === 'Enter') send(); });

  document.getElementById('lc-close').addEventListener('click', function(){
    if (!current) return;
    fetch('/support/admin/sessions/' + encodeURIComponent(current) + '/close', {
      method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}, body:'{}'
    }).then(function(){ setTimeout(function(){ location.reload(); }, 500); });
  });

  document.addEventListener('click', function(e){
    var b = e.target.closest('.lc-item');
    if (b) open(b.dataset.key, b.dataset.name);
  });

  document.getElementById('lc-filter').addEventListener('input', function(e){
    var q = e.target.value.toLowerCase();
    document.querySelectorAll('.lc-item').forEach(function(b){
      b.style.display = (b.dataset.name || '').toLowerCase().indexOf(q) >= 0 ? '' : 'none';
    });
  });

  // Real-time: SSE for the whole inbox, polling fallback
  function refreshList(){
    fetch('/support/admin/sessions').then(function(r){ return r.json(); }).then(function(d){
      document.getElementById('lc-unread').textContent = (d.unread_total || 0) + ' ' + LC_I18N.unread;
      var existing = {};
      document.querySelectorAll('.lc-item').forEach(function(b){ existing[b.dataset.key] = b; });
      (d.sessions || []).forEach(function(s){
        var el = existing[s.session_key];
        if (!el) { setTimeout(function(){ location.reload(); }, 400); }
      });
      // refresh the open conversation
      if (current) {
        fetch('/support/admin/sessions/' + encodeURIComponent(current) + '/messages')
          .then(function(r){ return r.json(); })
          .then(function(d){ (d.messages || []).forEach(render); });
      }
    }).catch(function(){});
  }
  if (typeof EventSource !== 'undefined') {
    try {
      stream = new EventSource('/support/admin/stream');
      stream.onopen = function(){ document.getElementById('lc-status').innerHTML = '<span class="live-dot" style="background:#fff;"></span>' + esc(LC_I18N.live); };
      stream.addEventListener('message', function(ev){
        try {
          var d = JSON.parse(ev.data);
          if (d.type === 'message' && d.session_key === current && d.message) render(d.message);
          refreshList();
        } catch(e){}
      });
      stream.onerror = function(){ stream.close(); stream = null; startPoll(); };
    } catch(e){ startPoll(); }
  } else { startPoll(); }
  function startPoll(){
    document.getElementById('lc-status').innerHTML = '<span class="live-dot" style="background:#fff;"></span>' + esc(LC_I18N.polling);
    if (poll) return;
    poll = setInterval(refreshList, 6000);
  }
})();
</script>

<%- include('../partials/footer') %>
