<%- include('../partials/header') %>
<div class="container mt-4">
  <div class="card border-0 shadow-lg" style="border-radius:22px; overflow:hidden;">
    <div class="p-4" style="background:linear-gradient(135deg,#0f172a,#1e293b); color:#fff;">
      <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
          <img src="/logo.png" alt="BloodOra" style="height:44px; background:#fff; border-radius:12px; padding:6px;" onerror="this.style.display='none'">
          <div>
            <h4 class="fw-bold mb-0" style="letter-spacing:-.02em;">BloodOra — Invoice</h4>
            <small style="opacity:.8;">Kalai, Joypurhat • <%= order.created_at? order.created_at.slice(0,10):'' %> • Order #<%= order.id %></small>
          </div>
        </div>
        <div class="text-end">
          <div class="badge bg-white text-dark rounded-pill">PAID: <%= order.payment_status %></div>
          <div class="small mt-1" style="opacity:.8;">Status: <%= order.status %></div>
        </div>
      </div>
    </div>
    <div class="card-body p-4">
      <div class="row g-4">
        <div class="col-md-6"><h6 class="fw-bold">Bill To</h6><div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="fw-bold"><%= customer_name %></div><div class="small text-muted"><%= customer_phone %> • <%= customer_email %></div><div class="small mt-2"><%= order.delivery_address %><br><%= [order.delivery_upazila, order.delivery_district, order.delivery_division].filter(Boolean).join(', ') %></div></div></div>
        <div class="col-md-6"><h6 class="fw-bold">Payment Info</h6><div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="small">Method: <strong><%= order.payment_method %></strong></div><div class="small">TrxID: <strong><%= order.transaction_id||'—' %></strong></div><div class="small">Date: <%= order.created_at? new Date(order.created_at).toLocaleString():'' %></div><div class="small">Delivery: <span class="badge bg-success">৳<%= order.delivery_charge %> (Kalai)</span></div></div></div>
      </div>

      <div class="table-responsive mt-4">
        <table class="table">
          <thead><tr><th>#</th><th>Product</th><th class="text-end">Price</th><th class="text-center">Qty</th><th class="text-end">Subtotal</th></tr></thead>
          <tbody>
            <% items.forEach((it,i)=>{ %>
              <tr><td><%= i+1 %></td><td class="fw-bold"><%= it.product_name %></td><td class="text-end">৳<%= it.price %></td><td class="text-center"><%= it.quantity %></td><td class="text-end fw-bold">৳<%= (it.price*it.quantity).toFixed(2) %></td></tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr><td colspan="4" class="text-end">Subtotal</td><td class="text-end fw-bold">৳<%= order.subtotal_amount.toFixed(2) %></td></tr>
            <tr><td colspan="4" class="text-end">Delivery Charge</td><td class="text-end fw-bold" style="color:#16a34a;">৳<%= order.delivery_charge.toFixed(2) %></td></tr>
            <tr style="background:#f8fafc;"><td colspan="4" class="text-end fw-bold">Total</td><td class="text-end fw-bold h5 mb-0" style="color:var(--primary);">৳<%= order.total_amount.toFixed(2) %></td></tr>
          </tfoot>
        </table>
      </div>

      <div class="d-flex gap-2 mt-3">
        <button onclick="window.print()" class="btn btn-dark rounded-pill"><i class="fas fa-print me-1"></i>Print Invoice</button>
        <a href="/shop/admin/order/<%= order.id %>" class="btn btn-light border rounded-pill">Back to Order</a>
      </div>
      <div class="small text-muted mt-3 text-center">Thank you for shopping with BloodOra • Delivery only in Kalai • Support: <%= order.delivery_upazila||'Kalai' %> ৳10</div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
