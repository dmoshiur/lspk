<%
  const _t = (typeof t === 'function') ? t : (k) => k;
%>
<%- include('../partials/header') %>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="fw-bold mb-0"><i class="fas fa-receipt text-danger me-2"></i><%= _t('ord_id') %> #<%= order.id %></h2>
    <div class="d-flex gap-2">
      <a href="/shop/admin/orders" class="btn btn-light border btn-sm rounded-pill"><i class="fas fa-arrow-left me-1"></i><%= _t('common_back') %></a>
      <a href="/shop/admin/order/<%= order.id %>/invoice" class="btn btn-dark btn-sm rounded-pill"><i class="fas fa-file-invoice me-1"></i><%= _t('ord_receipt') %></a>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm" style="border-radius:18px;">
        <div class="card-header bg-white border-0 pt-3"><h6 class="fw-bold mb-0"><%= _t('ord_items') %></h6></div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table align-middle mb-0">
              <thead><tr><th><%= _t('ord_item') %></th><th><%= _t('prod_price') %></th><th><%= _t('ord_qty') %></th><th><%= _t('ord_subtotal') %></th></tr></thead>
              <tbody>
                <% items.forEach(it=>{ %>
                  <tr>
                    <td class="d-flex align-items-center gap-2"><img src="/uploads/<%= it.image_file||'default_product.jpg' %>" alt="<%= it.product_name %>" style="width:48px;height:48px;object-fit:cover;border-radius:10px; border:1px solid #e2e8f0;" onerror="this.src='https://via.placeholder.com/48'"><span class="fw-bold" style="font-size:.9rem;"><%= it.product_name %></span></td>
                    <td>৳<%= it.price %></td>
                    <td><%= it.quantity %></td>
                    <td class="fw-bold">৳<%= (it.price*it.quantity).toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm" style="border-radius:18px;">
        <div class="card-body">
          <h6 class="fw-bold"><i class="fas fa-user me-2 text-danger"></i><%= _t('ord_customer') %></h6>
          <div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
            <div class="fw-bold"><%= order.user_name || order.guest_name || _t('common_guest') %></div>
            <div class="small text-muted"><%= order.user_phone||order.guest_phone||'' %> • <%= order.user_email||order.guest_email||'' %></div>
          </div>
          <h6 class="fw-bold mt-3"><i class="fas fa-truck me-2 text-danger"></i><%= _t('co_delivery_address') %></h6>
          <div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
            <div class="small text-muted"><%= _t('co_full_address') %></div><div class="fw-bold"><%= order.delivery_address %></div>
            <div class="small"><%= [order.delivery_upazila, order.delivery_district, order.delivery_division].filter(Boolean).join(', ') %></div>
            <div class="small mt-2"><span class="badge bg-light text-dark border"><%= _t('ord_subtotal') %>: ৳<%= order.subtotal_amount %></span> <span class="badge bg-success"><%= _t('ord_delivery') %>: ৳<%= order.delivery_charge %></span> <span class="badge bg-danger"><%= _t('common_total') %>: ৳<%= order.total_amount %></span></div>
          </div>
          <h6 class="fw-bold mt-3"><i class="fas fa-credit-card me-2 text-success"></i><%= _t('ord_payment') %></h6>
          <div class="p-3 rounded-4" style="background:#f0fdf4; border:1px solid #bbf7d0;">
            <div class="fw-bold"><%= order.payment_method %> • <span class="badge <%= order.payment_status==='confirmed'?'bg-success':'bg-warning text-dark' %>"><%= order.payment_status === 'confirmed' ? _t('st_confirmed') : _t('st_pending') %></span></div>
            <div class="small text-muted">TrxID: <%= order.transaction_id||'—' %></div>
            <% if(order.payment_status!=='confirmed'){ %>
              <form method="POST" action="/shop/admin/order/<%= order.id %>/confirm-payment" class="mt-2"><button class="btn btn-success btn-sm w-100 rounded-pill"><i class="fas fa-check me-1"></i><%= _t('st_confirmed') %></button></form>
            <% } %>
          </div>

          <h6 class="fw-bold mt-3"><%= _t('common_status') %></h6>
          <form method="POST" action="/shop/admin/order/<%= order.id %>/update-status" class="d-flex gap-2">
            <select name="status" class="form-select">
              <option value="pending" <%= order.status==='pending'?'selected':'' %>><%= _t('st_pending') %></option>
              <option value="processing" <%= order.status==='processing'?'selected':'' %>><%= _t('st_processing') %></option>
              <option value="completed" <%= order.status==='completed'?'selected':'' %>><%= _t('st_completed') %></option>
              <option value="cancelled" <%= order.status==='cancelled'?'selected':'' %>><%= _t('st_cancelled') %></option>
            </select>
            <button class="btn btn-danger rounded-pill"><%= _t('common_save') %></button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
