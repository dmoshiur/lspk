<%- include('../partials/header') %>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold mb-0"><i class="fas fa-receipt text-danger me-2"></i>Order #<%= order.id %></h2>
    <div class="d-flex gap-2">
      <a href="/shop/admin/orders" class="btn btn-light border btn-sm rounded-pill">Back</a>
      <a href="/shop/admin/order/<%= order.id %>/invoice" class="btn btn-dark btn-sm rounded-pill"><i class="fas fa-file-invoice me-1"></i>Invoice</a>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm" style="border-radius:18px;">
        <div class="card-header bg-white border-0 pt-3"><h6 class="fw-bold mb-0">Items</h6></div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table align-middle mb-0">
              <thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Subtotal</th></tr></thead>
              <tbody>
                <% items.forEach(it=>{ %>
                  <tr>
                    <td class="d-flex align-items-center gap-2"><img src="/uploads/<%= it.image_file||'default_product.jpg' %>" style="width:48px;height:48px;object-fit:cover;border-radius:10px; border:1px solid #e2e8f0;" onerror="this.src='https://via.placeholder.com/48'"><span class="fw-bold" style="font-size:.9rem;"><%= it.product_name %></span></td>
                    <td>৳<%= it.price %></td>
                    <td><%= it.quantity %></td>
                    <td class="fw-bold">৳<%= (it.price*it.quantity).toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm" style="border-radius:18px;">
        <div class="card-body">
          <h6 class="fw-bold"><i class="fas fa-user me-2 text-danger"></i>Customer</h6>
          <div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
            <div class="fw-bold"><%= order.user_name||order.guest_name||'Guest' %></div>
            <div class="small text-muted"><%= order.user_phone||order.guest_phone||'' %> • <%= order.user_email||order.guest_email||'' %></div>
          </div>
          <h6 class="fw-bold mt-3"><i class="fas fa-truck me-2 text-danger"></i>Delivery</h6>
          <div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
            <div class="small text-muted">Address</div><div class="fw-bold"><%= order.delivery_address %></div>
            <div class="small"><%= [order.delivery_upazila, order.delivery_district, order.delivery_division].filter(Boolean).join(', ') %></div>
            <div class="small mt-2"><span class="badge bg-light text-dark border">Subtotal: ৳<%= order.subtotal_amount %></span> <span class="badge bg-success">Delivery: ৳<%= order.delivery_charge %></span> <span class="badge bg-danger">Total: ৳<%= order.total_amount %></span></div>
          </div>
          <h6 class="fw-bold mt-3"><i class="fas fa-credit-card me-2 text-success"></i>Payment</h6>
          <div class="p-3 rounded-4" style="background:#f0fdf4; border:1px solid #bbf7d0;">
            <div class="fw-bold"><%= order.payment_method %> • <span class="badge <%= order.payment_status==='confirmed'?'bg-success':'bg-warning text-dark' %>"><%= order.payment_status %></span></div>
            <div class="small text-muted">TrxID: <%= order.transaction_id||'—' %></div>
            <% if(order.payment_status!=='confirmed'){ %>
              <form method="POST" action="/shop/admin/order/<%= order.id %>/confirm-payment" class="mt-2"><button class="btn btn-success btn-sm w-100 rounded-pill"><i class="fas fa-check me-1"></i>Confirm Payment</button></form>
            <% } %>
          </div>

          <h6 class="fw-bold mt-3">Update Status</h6>
          <form method="POST" action="/shop/admin/order/<%= order.id %>/update-status" class="d-flex gap-2">
            <select name="status" class="form-select">
              <option value="pending" <%= order.status==='pending'?'selected':'' %>>Pending</option>
              <option value="processing" <%= order.status==='processing'?'selected':'' %>>Processing</option>
              <option value="completed" <%= order.status==='completed'?'selected':'' %>>Completed</option>
              <option value="cancelled" <%= order.status==='cancelled'?'selected':'' %>>Cancelled</option>
            </select>
            <button class="btn btn-danger rounded-pill">Update</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
