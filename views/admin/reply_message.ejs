<%
  const _t = (typeof t === 'function') ? t : (k) => k;
%>
<%- include('../partials/header') %>
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-lg p-4" style="border-radius:22px;">
        <h4 class="fw-bold mb-3"><i class="fas fa-reply me-2 text-danger"></i><%= _t('msg_reply') %>: <%= original.sender_name||('User #'+original.sender_id) %></h4>
        <div class="p-3 rounded-4 mb-3" style="background:#f8fafc; border:1px solid #e2e8f0;">
          <div class="fw-bold"><%= original.subject %></div>
          <div class="small text-muted"><%= new Date(original.created_at).toLocaleString() %></div>
          <div class="mt-2" style="white-space:pre-wrap;"><%= original.content %></div>
        </div>
        <form method="POST">
          <div class="mb-3"><label class="form-label"><%= _t('msg_reply') %></label><textarea name="content" class="form-control" rows="5" required placeholder="<%= _t('msg_content') %>..."></textarea></div>
          <div class="d-flex gap-2"><a href="/messages/admin/messages" class="btn btn-light border rounded-pill"><%= _t('common_cancel') %></a><button class="btn btn-danger rounded-pill"><i class="fas fa-paper-plane me-1"></i><%= _t('chat_send') %></button></div>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
