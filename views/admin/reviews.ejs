<%- include('../partials/header') %>
<%
  const _rs = (typeof reviews !== 'undefined' && reviews) ? reviews : [];
  const _c  = (typeof counts !== 'undefined' && counts) ? counts : { pending:0, approved:0, rejected:0 };
  const _f  = (typeof filter !== 'undefined') ? filter : '';
  // EJS's escaped output tag escapes exactly once. The old local escaper ran on
  // top of it and leaked literal &#39; / &amp; sequences into the rendered page.
  const BADGE = { pending:'bg-warning text-dark', approved:'bg-success', rejected:'bg-secondary' };
%>

<div class="container mt-4 mb-5">
  <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
      <h2 class="fw-bold mb-0"><i class="fas fa-star text-warning me-2"></i>Review Moderation</h2>
      <small class="text-muted">Approve, feature, reply to and remove product reviews and testimonials.</small>
    </div>
    <a href="/reviews" target="_blank" class="btn btn-sm btn-light border rounded-pill"><i class="fas fa-external-link me-1"></i>View /reviews</a>
  </div>

  <div class="admin-wrapper">
    <%- include('_sidebar', { active: 'reviews', stats: {} }) %>

    <main class="flex-grow-1" style="min-width:0;">
      <div class="d-flex gap-2 mb-3 flex-wrap">
        <a href="/admin/reviews" class="btn btn-sm <%= !_f ? 'btn-danger':'btn-outline-danger' %> rounded-pill">All (<%= (_c.pending||0)+(_c.approved||0)+(_c.rejected||0) %>)</a>
        <a href="/admin/reviews?status=pending" class="btn btn-sm <%= _f==='pending' ? 'btn-warning':'btn-outline-warning' %> rounded-pill">Pending (<%= _c.pending||0 %>)</a>
        <a href="/admin/reviews?status=approved" class="btn btn-sm <%= _f==='approved' ? 'btn-success':'btn-outline-success' %> rounded-pill">Approved (<%= _c.approved||0 %>)</a>
        <a href="/admin/reviews?status=rejected" class="btn btn-sm <%= _f==='rejected' ? 'btn-secondary':'btn-outline-secondary' %> rounded-pill">Rejected (<%= _c.rejected||0 %>)</a>
      </div>

      <% if (_rs.length) { %>
        <div class="row g-3">
          <% _rs.forEach(function(r){ %>
            <div class="col-lg-6">
              <div class="card h-100 border-0 shadow-sm" style="border-radius:20px;<%= r.status==='pending' ? ' border-start border-4 border-warning' : '' %>">
                <div class="card-body p-4">
                  <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <div>
                      <div class="fw-bold"><%= r.user_name || r.author_name || 'Anonymous' %></div>
                      <div class="small text-muted"><%= r.user_email || '' %> · <%= String(r.created_at||'').slice(0,16).replace('T',' ') %></div>
                    </div>
                    <div class="text-end">
                      <span class="badge <%= BADGE[r.status] || 'bg-light text-dark border' %>"><%= r.status %></span>
                      <% if (r.is_featured) { %><span class="badge bg-warning text-dark d-block mt-1">Featured</span><% } %>
                    </div>
                  </div>

                  <div class="stars text-warning mb-1"><%= '★'.repeat(r.rating||5) + '☆'.repeat(5-(r.rating||5)) %></div>
                  <h6 class="fw-bold mb-1" style="font-family:var(--font-display); font-size:1.1rem;"><%= r.title || 'Untitled' %></h6>
                  <p class="small text-muted mb-2" style="line-height:1.7;"><%= r.body %></p>

                  <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge bg-light text-dark border"><i class="fas fa-<%= r.kind==='product' ? 'bag-shopping':'heart' %> me-1"></i><%= r.kind==='product' ? (r.product_name || 'Product') : 'Testimonial' %></span>
                  </div>

                  <% if (r.admin_reply) { %>
                    <div class="p-3 rounded-4 mb-3" style="background:#f0fdf4; border:1px solid #bbf7d0;">
                      <div class="small fw-bold text-success mb-1">Official reply</div>
                      <div class="small"><%= r.admin_reply %></div>
                    </div>
                  <% } %>

                  <div class="d-flex flex-wrap gap-2">
                    <% if (r.status !== 'approved') { %>
                      <form method="POST" action="/admin/reviews/<%= r.id %>/status"><input type="hidden" name="status" value="approved"><button class="btn btn-sm btn-success rounded-pill"><i class="fas fa-check me-1"></i>Approve</button></form>
                    <% } %>
                    <% if (r.status !== 'rejected') { %>
                      <form method="POST" action="/admin/reviews/<%= r.id %>/status"><input type="hidden" name="status" value="rejected"><button class="btn btn-sm btn-light border rounded-pill"><i class="fas fa-xmark me-1"></i>Reject</button></form>
                    <% } %>
                    <form method="POST" action="/admin/reviews/<%= r.id %>/feature"><button class="btn btn-sm btn-light border rounded-pill"><i class="fas fa-crown me-1"></i><%= r.is_featured ? 'Unfeature' : 'Feature' %></button></form>
                    <form method="POST" action="/admin/reviews/<%= r.id %>/delete" onsubmit="return confirm('Delete this review permanently?')"><button class="btn btn-sm btn-light border text-danger rounded-pill"><i class="fas fa-trash"></i></button></form>
                  </div>

                  <form method="POST" action="/admin/reviews/<%= r.id %>/reply" class="mt-3">
                    <div class="input-group input-group-sm">
                      <input name="admin_reply" class="form-control" placeholder="Public reply from BloodOra…" value="<%= r.admin_reply %>">
                      <button class="btn btn-outline-danger"><i class="fas fa-reply me-1"></i>Reply</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="alert alert-info text-center border-0 shadow-sm rounded-4 py-4">
          <i class="fas fa-star fa-2x d-block mb-2 text-warning"></i>No reviews in this view.
        </div>
      <% } %>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
