<%- include('partials/header') %>
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-lg p-4" style="border-radius:22px;">
        <h3 class="fw-bold mb-4"><i class="fas fa-edit me-2 text-danger"></i>Edit Profile</h3>
        <form method="POST" enctype="multipart/form-data">
          <div class="mb-3 text-center">
            <% if (user.image_file && user.image_file!=='default.jpg'){ %><img src="/uploads/<%= user.image_file %>" class="rounded-circle mb-2" style="width:92px;height:92px;object-fit:cover;"><% } %>
            <div><label class="form-label">New Profile Picture</label><input type="file" name="profile_pic" class="form-control" accept="image/*"></div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Full Name</label><input type="text" name="name" class="form-control" value="<%= user.name %>" required></div>
            <div class="col-md-6 mb-3"><label class="form-label">Phone</label><input type="text" name="phone" class="form-control" value="<%= user.phone %>" required></div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Holding / House</label><input type="text" name="holding" class="form-control" value="<%= user.address_holding||'' %>"></div>
            <div class="col-md-6 mb-3"><label class="form-label">Birth Certificate</label><input type="text" name="birth_certificate" class="form-control" value="<%= user.birth_certificate_number||'' %>"></div>
          </div>
          <div class="mb-3"><label class="form-label">Date of Birth</label><input type="date" name="date_of_birth" class="form-control" value="<%= user.date_of_birth? user.date_of_birth.slice(0,10):'' %>"></div>
          <div class="d-flex gap-2">
            <a href="/donors/profile/my" class="btn btn-light border rounded-pill">Cancel</a>
            <button type="submit" class="btn btn-danger rounded-pill px-4">Save Changes</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
