<%- include('partials/header') %>

<!-- Hero -->
<section class="hero-section">
  <div class="container position-relative" style="z-index:1;">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <div class="d-inline-flex align-items-center gap-2 mb-3 px-3 py-2 rounded-pill" style="background:rgba(255,255,255,.14); border:1px solid rgba(255,255,255,.22); backdrop-filter:blur(8px); font-weight:700; font-size:.82rem; letter-spacing:.04em;">
          <span class="badge bg-white text-danger rounded-pill px-2 py-1"><i class="fas fa-shield-heart me-1"></i>VERIFIED</span>
          Bangladesh's Trusted Network
        </div>
        <h1 class="mb-3">Donate Blood, Save Lives <i class="fas fa-heart" style="color:#ff8fa0;"></i></h1>
        <p class="lead mb-4">Bangladesh's Smart Blood Donation Platform — ultra-fast, serverless, and always available. Same beloved BloodOra theme, now crystal-clear and refined.</p>
        <div class="d-flex flex-wrap gap-3">
          <a href="/request-blood" class="btn btn-light btn-lg"><i class="fas fa-plus-circle me-2"></i>Request Blood</a>
          <a href="/donors" class="btn btn-outline-light btn-lg" style="border:2px solid rgba(255,255,255,.9); color:#fff; background:rgba(255,255,255,.1); backdrop-filter:blur(8px);"> <i class="fas fa-users me-2"></i>Find Donors</a>
          <a href="/shop" class="btn btn-dark btn-lg" style="background:rgba(15,23,42,.95); border:none; box-shadow:0 10px 28px rgba(0,0,0,.2);"> <i class="fas fa-shopping-bag me-2"></i>Shop Medicine</a>
        </div>
        <div class="d-flex flex-wrap gap-3 mt-4 small" style="color:rgba(255,255,255,.92);">
          <span><i class="fas fa-check-circle me-1"></i>64 Districts</span>
          <span><i class="fas fa-check-circle me-1"></i>8 Blood Groups</span>
          <span><i class="fas fa-check-circle me-1"></i>Turso Serverless • 24/7</span>
        </div>
      </div>
      <div class="col-lg-5 d-none d-lg-block">
        <div class="p-1 rounded-4" style="background:rgba(255,255,255,.14); backdrop-filter:blur(14px); border:1px solid rgba(255,255,255,.2); box-shadow:0 20px 60px rgba(0,0,0,.18);">
          <div class="rounded-4 overflow-hidden" style="background:#fff; padding:18px;">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div class="fw-bold" style="color:#0f172a;"><i class="fas fa-tint text-danger me-2"></i>Live Activity</div>
              <span class="badge bg-success rounded-pill"><span style="width:8px;height:8px; background:#fff; border-radius:50%; display:inline-block; margin-right:6px; animation:pulse 1.2s infinite;"></span>Live</span>
            </div>
            <div class="d-grid gap-2">
              <div class="d-flex align-items-center gap-3 p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
                <img src="https://ui-avatars.com/api/?name=Urgent+Request&background=e31b23&color=fff&bold=true" style="width:46px;height:46px;border-radius:50%;">
                <div><div class="fw-bold" style="font-size:.95rem;">Urgent B+ Needed</div><div class="small text-muted">Joypurhat • 2 min ago</div></div>
                <span class="badge bg-danger ms-auto">URGENT</span>
              </div>
              <div class="d-flex align-items-center gap-3 p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
                <img src="https://ui-avatars.com/api/?name=New+Donor&background=0f172a&color=fff&bold=true" style="width:46px;height:46px;border-radius:50%;">
                <div><div class="fw-bold" style="font-size:.95rem;">New Verified Donor</div><div class="small text-muted">A+ • Dhaka</div></div>
                <span class="badge bg-success ms-auto">VERIFIED</span>
              </div>
              <div class="d-flex align-items-center gap-3 p-3 rounded-4" style="background:#fff7ed; border:1px solid #ffedd5;">
                <div style="width:46px;height:46px;border-radius:50%; background:linear-gradient(135deg,#e31b23,#ff3340); color:#fff; display:flex; align-items:center; justify-content:center;"><i class="fas fa-shopping-bag"></i></div>
                <div><div class="fw-bold" style="font-size:.95rem;">Shop Order Delivered</div><div class="small text-muted">Kalai • Free tracking</div></div>
                <span class="badge bg-warning text-dark ms-auto">৳10 delivery</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>@keyframes pulse{0%{opacity:1}50%{opacity:.4}100%{opacity:1}}</style>

<!-- Stats -->
<section class="container mb-4">
  <div class="row g-3">
    <div class="col-6 col-md-3"><div class="stat-card"><h3><%= total_donors %></h3><p>Verified Donors</p></div></div>
    <div class="col-6 col-md-3"><div class="stat-card"><h3><%= urgent_requests %></h3><p>Urgent Cases</p></div></div>
    <div class="col-6 col-md-3"><div class="stat-card"><h3>64</h3><p>Districts Covered</p></div></div>
    <div class="col-6 col-md-3"><div class="stat-card"><h3>8</h3><p>Blood Groups</p></div></div>
  </div>
</section>

<% if (typeof notice !== 'undefined' && notice) { %>
<div class="container mb-4">
  <div class="alert alert-danger border-0 d-flex align-items-center gap-3" style="background:linear-gradient(135deg,#fff0f0,#ffe4e6); color:#9f1239; font-weight:700;">
    <span class="d-inline-flex align-items-center justify-content-center" style="width:42px;height:42px;border-radius:50%; background:var(--primary); color:#fff; flex-shrink:0;"><i class="fas fa-bullhorn"></i></span>
    <div>Notice: <%= notice.content %></div>
  </div>
</div>
<% } %>

<!-- Urgent -->
<% if (typeof recent_requests !== 'undefined' && recent_requests && recent_requests.length) { %>
<section class="container mb-5">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="h4 fw-bold mb-0" style="letter-spacing:-.02em;"><i class="fas fa-exclamation-triangle text-danger me-2"></i>Urgent Blood Requests</h2>
    <a href="/blood-requests?urgent=true" class="btn btn-sm btn-outline-danger">View all</a>
  </div>
  <div class="row g-3">
    <% recent_requests.filter(r=>r.is_urgent && !r.is_fulfilled).slice(0,3).forEach(req => { %>
      <div class="col-md-4">
        <div class="card h-100" style="border-top:4px solid var(--primary);">
          <div class="card-header d-flex align-items-center justify-content-between" style="background:#fff0f0; border-bottom:1px solid #ffe4e6; color:#9f1239; font-weight:800;">
            <span><i class="fas fa-ambulance me-2"></i>URGENT</span>
            <span class="badge bg-danger"><%= req.blood_group %> Needed</span>
          </div>
          <div class="card-body">
            <h5 class="fw-bold"><%= req.blood_group %> Needed</h5>
            <div class="small text-muted d-grid gap-1">
              <div><i class="fas fa-user me-2 text-danger"></i><strong>Patient:</strong> <%= req.patient_name %></div>
              <div><i class="fas fa-hospital me-2 text-danger"></i><%= req.hospital_name %>, <%= req.location_district %></div>
              <div><i class="fas fa-clock me-2 text-danger"></i>Needed by: <%= new Date(req.needed_by).toLocaleString('en-GB', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' }) %></div>
            </div>
          </div>
          <div class="card-footer bg-white border-0">
            <a href="/blood-request/<%= req.id %>" class="btn btn-danger w-100"><i class="fas fa-hand-holding-medical me-2"></i>View & Help</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<!-- How it works -->
<section class="container mb-5">
  <h2 class="text-center fw-bold mb-4" style="letter-spacing:-.02em;"><i class="fas fa-cogs me-2 text-danger"></i>How BloodOra Works</h2>
  <div class="row g-3">
    <div class="col-6 col-md-3"><div class="process-step"><div class="step-number">1</div><h5 class="fw-bold">Register</h5><p class="small text-muted mb-0">Create your profile. Donors must be 18+.</p></div></div>
    <div class="col-6 col-md-3"><div class="process-step"><div class="step-number">2</div><h5 class="fw-bold">Get Verified</h5><p class="small text-muted mb-0">Admin verifies donors for safety.</p></div></div>
    <div class="col-6 col-md-3"><div class="process-step"><div class="step-number">3</div><h5 class="fw-bold">Find / Request</h5><p class="small text-muted mb-0">Search donors or request blood instantly.</p></div></div>
    <div class="col-6 col-md-3"><div class="process-step"><div class="step-number">4</div><h5 class="fw-bold">Save Lives</h5><p class="small text-muted mb-0">Connect, donate, and make a difference.</p></div></div>
  </div>
</section>

<!-- Recent Donors -->
<section class="container mb-5">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="h4 fw-bold mb-0" style="letter-spacing:-.02em;"><i class="fas fa-users me-2 text-danger"></i>Recent Verified Donors</h2>
    <a href="/donors" class="btn btn-sm btn-outline-danger">View all donors <i class="fas fa-arrow-right ms-1"></i></a>
  </div>
  <div class="row g-3">
    <% if (recent_donors && recent_donors.length) { %>
      <% recent_donors.forEach(donor => { %>
        <div class="col-6 col-md-2">
          <div class="card text-center h-100 p-3">
            <% if (donor.image_file && donor.image_file !== 'default.jpg') { %>
              <img src="/uploads/<%= donor.image_file %>" class="rounded-circle mx-auto mb-2" alt="<%= donor.name %>" style="width:78px;height:78px;object-fit:cover; border:3px solid #fff; box-shadow:0 8px 20px rgba(15,23,42,.12);">
            <% } else { %>
              <img src="https://ui-avatars.com/api/?background=random&name=<%= encodeURIComponent(donor.name) %>&size=128&bold=true" class="rounded-circle mx-auto mb-2" alt="<%= donor.name %>" style="width:78px;height:78px;object-fit:cover; border:3px solid #fff; box-shadow:0 8px 20px rgba(15,23,42,.12);">
            <% } %>
            <div class="fw-bold" style="font-size:.95rem; letter-spacing:-.01em;"><%= donor.name %></div>
            <div class="badge bg-danger mt-1"><%= donor.blood_group %></div>
            <div class="small text-muted mt-1"><i class="fas fa-map-marker-alt me-1"></i><%= donor.district || donor.division || 'Bangladesh' %></div>
            <a href="/donors/profile/view/<%= donor.id %>" class="btn btn-sm btn-outline-danger mt-2 rounded-pill px-3">View</a>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-12"><div class="alert alert-info text-center border-0 shadow-sm rounded-4">Be the first verified donor! <a href="/register" class="alert-link">Register now</a></div></div>
    <% } %>
  </div>
</section>

<!-- Shop Teaser -->
<section class="container mb-2">
  <div class="card border-0 overflow-hidden" style="background:linear-gradient(135deg,#0f172a 0%, #1e293b 100%); color:#fff; border-radius:22px;">
    <div class="row g-0 align-items-center">
      <div class="col-lg-7 p-4 p-lg-5">
        <div class="badge bg-danger rounded-pill mb-3 px-3 py-2"><i class="fas fa-shopping-bag me-2"></i> BloodOra Shop • Ultra shop</div>
        <h3 class="fw-bold mb-2" style="letter-spacing:-.02em;">Medical Shop — Fully Workable, Serverless Checkout</h3>
        <p class="mb-3" style="color:#cbd5e1;">Browse medicines, healthcare & supplements. Add to cart, update quantity, and checkout with ৳10 delivery only in Kalai. Stock managed in Turso, invoice ready — no bugs.</p>
        <div class="d-flex flex-wrap gap-2">
          <a href="/shop" class="btn btn-danger"><i class="fas fa-bag-shopping me-2"></i>Go to Shop</a>
          <a href="/shop/cart" class="btn btn-outline-light" style="border:2px solid rgba(255,255,255,.9);"><i class="fas fa-cart-shopping me-2"></i>View Cart</a>
        </div>
        <div class="small mt-3" style="color:#94a3b8;"><i class="fas fa-truck me-1"></i>Delivery ONLY in Kalai Upazila • bKash/Nagad/Rocket/Upay/Pathao/Card/COD • Invoice + Admin confirmation</div>
      </div>
      <div class="col-lg-5 p-3">
        <div class="rounded-4 overflow-hidden" style="background:#fff; padding:14px;">
          <div class="d-flex gap-2">
            <div class="flex-fill p-3 rounded-4 text-center" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="fw-bold text-danger">৳10</div><div class="small text-muted">Delivery</div></div>
            <div class="flex-fill p-3 rounded-4 text-center" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="fw-bold text-danger"><i class="fas fa-shield-check"></i> Secure</div><div class="small text-muted">Turso ACID</div></div>
            <div class="flex-fill p-3 rounded-4 text-center" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="fw-bold text-danger"><i class="fas fa-file-invoice"></i> Invoice</div><div class="small text-muted">Auto PDF</div></div>
          </div>
          <div class="mt-3">
            <div class="small fw-bold text-muted mb-2">Popular now</div>
            <div class="d-grid gap-2">
              <div class="d-flex align-items-center gap-2 p-2 rounded-3" style="background:#f1f5f9;"><i class="fas fa-pills text-danger"></i><span class="small fw-bold">Amaryl M 1mg</span><span class="ms-auto small fw-bold text-danger">৳245</span></div>
              <div class="d-flex align-items-center gap-2 p-2 rounded-3" style="background:#f1f5f9;"><i class="fas fa-kit-medical text-danger"></i><span class="small fw-bold">First Aid Kit</span><span class="ms-auto small fw-bold text-danger">৳850</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
