<%- include('partials/header') %>
<div class="container mt-4">
  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
      <h2 class="fw-bold mb-1" style="letter-spacing:-.02em;"><i class="fas fa-shopping-bag text-danger me-2"></i><%= t('shop_title') %></h2>
      <p class="text-muted mb-0"><%= t('shop_sub') %></p>
    </div>
    <a href="/shop/cart" class="btn btn-danger"><i class="fas fa-cart-shopping me-2"></i><%= t('shop_view_cart') %> <% if (typeof sessionCartCount !== 'undefined' && sessionCartCount) { %><span class="badge bg-white text-danger ms-2"><%= sessionCartCount %></span><% } %></a>
  </div>

  <% if (typeof shopError !== 'undefined' && shopError) { %>
    <div class="alert alert-danger border-0 rounded-4 d-flex align-items-start gap-3 mb-4" role="alert">
      <i class="fas fa-plug-circle-exclamation fa-lg mt-1"></i>
      <div>
        <div class="fw-bold mb-1"><%= t('common_load_failed') %></div>
        <div class="small"><%= shopError %></div>
        <div class="small mt-2">
          <a href="/shop" class="btn btn-sm btn-danger rounded-pill me-1"><i class="fas fa-rotate me-1"></i><%= t('common_retry') %></a>
          <button class="btn btn-sm btn-outline-primary rounded-pill" style="border-color:#c7d2fe; color:#4338ca;" onclick="document.getElementById('bo-ai-fab')?.click()"><i class="fas fa-robot me-1"></i><%= t('err_ai') %></button>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Filters -->
  <div class="card p-3 mb-4 border-0 shadow-sm" style="border-radius:18px; background:#fff;">
    <form method="GET" class="row g-2 align-items-center">
      <div class="col-md-4">
        <select name="category" class="form-select" onchange="this.form.submit()">
          <option value=""><%= t('shop_all_cats') %></option>
          <% categories.forEach(cat=>{ %>
            <option value="<%= cat %>" <%= (query && query.category===cat)?'selected':'' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-6">
        <div class="input-group">
          <span class="input-group-text bg-white" style="border-radius:12px 0 0 12px;"><i class="fas fa-search text-muted"></i></span>
          <input type="text" name="search" class="form-control" placeholder="<%= t('shop_search_ph') %>" value="<%= query && query.search ? query.search : '' %>" style="border-left:0;">
        </div>
      </div>
      <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-danger"><i class="fas fa-filter me-1"></i><%= t('shop_filter') %></button>
      </div>
    </form>
  </div>

  <!-- Products -->
  <div class="row g-3 g-md-4">
    <% if (products && products.length) { %>
      <% products.forEach(product=>{ %>
        <div class="col-6 col-md-4 col-lg-3">
          <div class="card h-100 border-0 shadow-sm overflow-hidden" style="border-radius:18px;">
            <div style="position:relative; background:#f8fafc;">
              <% if (product.image_file && product.image_file !== 'default_product.jpg') { %>
                <img src="/uploads/<%= product.image_file %>" class="card-img-top" alt="<%= product.name %>" style="height:200px; object-fit:cover;">
              <% } else { %>
                <div class="d-flex align-items-center justify-content-center" style="height:200px; background:linear-gradient(135deg,#f1f5f9,#e2e8f0);">
                  <i class="fas fa-box fa-3x" style="color:#94a3b8;"></i>
                </div>
              <% } %>
              <span class="badge bg-white text-dark position-absolute" style="top:12px; left:12px; border:1px solid #e2e8f0; box-shadow:0 4px 12px rgba(15,23,42,.08);"><%= product.category||'General' %></span>
              <% if (product.stock>0) { %><span class="badge bg-success position-absolute" style="top:12px; right:12px;"><%= t('shop_in_stock') %>: <%= product.stock %></span><% } else { %><span class="badge bg-danger position-absolute" style="top:12px; right:12px;"><%= t('shop_out') %></span><% } %>
            </div>
            <div class="card-body d-flex flex-column">
              <h6 class="fw-bold mb-1" style="letter-spacing:-.01em; min-height:44px;"><%= product.name %></h6>
              <p class="small text-muted flex-grow-1 mb-2" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;"><%= product.description||'High quality product from BloodOra Shop.' %></p>
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="h5 fw-bold mb-0" style="color:var(--primary);">৳<%= product.price %></div>
                <div class="small text-muted"><i class="fas fa-star text-warning me-1"></i>4.8</div>
              </div>
              <div class="d-grid gap-2">
                <div class="btn-group">
                  <a href="/shop/product/<%= product.id %>" class="btn btn-outline-danger btn-sm flex-fill"><i class="fas fa-eye me-1"></i>View</a>
                  <% if (product.stock>0 && product.is_available) { %>
                    <button onclick="addToCart(<%= product.id %>)" class="btn btn-danger btn-sm flex-fill"><i class="fas fa-cart-plus me-1"></i><%= t('shop_add') %></button>
                  <% } else { %>
                    <button class="btn btn-secondary btn-sm flex-fill" disabled>Sold Out</button>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-12"><div class="alert alert-info text-center border-0 rounded-4"><i class="fas fa-info-circle fa-2x mb-2 d-block"></i><h5><%= t('shop_none') %></h5><p class="mb-0"><%= t('common_retry') %></p></div></div>
    <% } %>
  </div>
</div>

<!-- Floating cart -->
<div id="cart-float" class="d-none" style="position:fixed; right:18px; bottom:18px; z-index:1040;">
  <a href="/shop/cart" class="btn btn-danger btn-lg shadow-lg rounded-pill px-4" style="box-shadow:0 12px 30px rgba(227,27,35,.35);">
    <i class="fas fa-shopping-cart me-2"></i>Cart (<span id="cart-count"><%= typeof sessionCartCount !== 'undefined' ? sessionCartCount : 0 %></span>)
  </a>
</div>
<script>
  (function(){
    const count = <%= typeof sessionCartCount !== 'undefined' ? sessionCartCount : 0 %>;
    if(count>0) document.getElementById('cart-float').classList.remove('d-none');
  })();
  async function addToCart(id){
    try{
      const res = await fetch(`/shop/cart/add/${id}`, { method:'POST', headers:{'Content-Type':'application/json', 'Accept':'application/json'}, body:'{}' });
      const data = await res.json();
      if(data.success){
        const toast = document.createElement('div');
        toast.className='alert alert-success position-fixed';
        toast.style.cssText='top:20px; right:20px; z-index:2000; border-radius:14px; box-shadow:0 12px 30px rgba(15,23,42,.12);';
        toast.innerHTML='<i class="fas fa-check-circle me-2"></i>'+data.message;
        document.body.appendChild(toast);
        setTimeout(()=>toast.remove(), 2200);
        const floatEl=document.getElementById('cart-float'); floatEl.classList.remove('d-none');
        const cntEl=document.getElementById('cart-count'); if(cntEl) cntEl.textContent=data.cartCount;
        // Try reload cart count badge in navbar?
      } else {
        alert(data.message||'Failed to add to cart');
      }
    }catch(e){
      // Fallback to form submit if fetch fails
      const f=document.createElement('form'); f.method='POST'; f.action=`/shop/cart/add/${id}`; document.body.appendChild(f); f.submit();
    }
  }
</script>

<%- include('partials/footer') %>
