<%- include('partials/header') %>
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-9">
      <div class="card border-0 shadow-lg p-4 p-lg-5" style="border-radius:22px;">
        <h2 class="fw-bold text-center mb-1" style="color:var(--primary);"><i class="fas fa-plus-circle me-2"></i>Request Blood</h2>
        <p class="text-center text-muted">Urgent or planned — donors are notified instantly via Turso.</p>
        <form method="POST" action="/request-blood" class="mt-3">
          <h5 class="fw-bold border-bottom pb-2 mb-3"><i class="fas fa-user-injured me-2 text-danger"></i>Patient Information</h5>
          <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Patient Name *</label><input type="text" name="patient_name" class="form-control" required placeholder="Full name"></div>
            <div class="col-md-3 mb-3"><label class="form-label">Blood Group *</label><select name="blood_group" class="form-select" required><option value="">Select</option><% ["A+","A-","B+","B-","O+","O-","AB+","AB-"].forEach(bg=>{ %><option><%= bg %></option><% }) %></select></div>
            <div class="col-md-3 mb-3"><label class="form-label">Quantity</label><input type="text" name="quantity" class="form-control" value="1 unit" placeholder="1 unit"></div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Relation</label><select name="patient_relation" class="form-select"><option>Self</option><option>Family</option><option>Friend</option><option>Other</option></select></div>
            <div class="col-md-6 mb-3"><label class="form-label">Needed By *</label><input type="datetime-local" name="needed_by" class="form-control" required></div>
          </div>

          <h5 class="fw-bold border-bottom pb-2 mb-3 mt-4"><i class="fas fa-hospital me-2 text-danger"></i>Hospital & Contact</h5>
          <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Hospital Name *</label><input type="text" name="hospital_name" class="form-control" required></div>
            <div class="col-md-6 mb-3"><label class="form-label">Hospital Address *</label><input type="text" name="hospital_address" class="form-control" required placeholder="Village/Road, Upazila, District"></div>
          </div>
          <div class="row">
            <div class="col-md-4 mb-3"><label class="form-label">Contact Person *</label><input type="text" name="contact_person" class="form-control" required></div>
            <div class="col-md-4 mb-3"><label class="form-label">Phone *</label><input type="tel" name="contact_phone" class="form-control" required placeholder="017XXXXXXXX"></div>
            <div class="col-md-4 mb-3"><label class="form-label">Email</label><input type="email" name="contact_email" class="form-control" placeholder="optional@example.com"></div>
          </div>

          <h5 class="fw-bold border-bottom pb-2 mb-3 mt-4"><i class="fas fa-map-marker-alt me-2 text-danger"></i>Location</h5>
          <div class="row">
            <div class="col-md-4 mb-3"><label class="form-label">Division *</label><select name="division" id="division" class="form-select" required><option value="">Select Division</option></select></div>
            <div class="col-md-4 mb-3"><label class="form-label">District *</label><select name="district" id="district" class="form-select" required disabled><option value="">Select District</option></select></div>
            <div class="col-md-4 mb-3"><label class="form-label">Upazila *</label><select name="upazila" id="upazila" class="form-select" required disabled><option value="">Select Upazila</option></select></div>
          </div>

          <div class="form-check p-3 rounded-4 mb-3" style="background:#fff7ed; border:1px solid #ffedd5;">
            <input class="form-check-input" type="checkbox" name="is_urgent" value="1" id="is_urgent" onchange="document.getElementById('urgent_reason_wrap').classList.toggle('d-none', !this.checked)">
            <label class="form-check-label fw-bold" for="is_urgent"><i class="fas fa-bolt text-danger me-2"></i>Mark as URGENT (needs immediate attention)</label>
          </div>
          <div id="urgent_reason_wrap" class="mb-3 d-none"><label class="form-label">Urgent Reason</label><textarea name="urgent_reason" class="form-control" rows="2" placeholder="Why is this urgent? e.g., operation tonight..."></textarea></div>
          <div class="mb-3"><label class="form-label">Additional Info</label><textarea name="additional_info" class="form-control" rows="3" placeholder="Anything donors should know..."></textarea></div>

          <div class="d-grid"><button type="submit" class="btn btn-danger btn-lg rounded-pill"><i class="fas fa-paper-plane me-2"></i>Submit Blood Request</button></div>
          <div class="text-center mt-3"><a href="/blood-requests" class="small text-decoration-none"><i class="fas fa-arrow-left me-1"></i>View Existing Requests</a></div>
        </form>
      </div>
    </div>
  </div>
</div>

