<%- include('partials/header') %>
<div class="container mt-4">
  <h2 class="fw-bold mb-3"><i class="fas fa-envelope text-danger me-2"></i><%= t('msg_title') %> <% if (unread_count){ %><span class="badge bg-danger"><%= unread_count %> <%= t('msg_unread') %></span><% } %></h2>
  <div class="row g-4">
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm" style="border-radius:18px;">
        <div class="card-header bg-white border-0 pt-3"><h6 class="fw-bold mb-0"><i class="fas fa-inbox me-2"></i><%= t('msg_inbox') %></h6></div>
        <div class="list-group list-group-flush">
          <% if (received && received.length){ %>
            <% received.forEach(m=>{ %>
              <a href="/messages/read/<%= m.id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center <%= !m.is_read?'bg-light':'' %>">
                <div><div class="fw-bold" style="font-size:.9rem;"><%= m.subject %></div><div class="small text-muted"><%= t('msg_from') %>: <%= m.sender_name||('#'+m.sender_id) %> • <%= new Date(m.created_at).toLocaleString() %></div></div>
                <% if(!m.is_read){ %><span class="badge bg-danger rounded-pill">●</span><% } %>
              </a>
            <% }) %>
          <% } else { %><div class="p-4 text-center text-muted"><%= t('msg_empty') %></div><% } %>
        </div>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm" style="border-radius:18px;">
        <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center"><h6 class="fw-bold mb-0"><i class="fas fa-paper-plane me-2"></i><%= t('msg_sent') %></h6><a href="/messages/send" class="btn btn-sm btn-danger rounded-pill">+ <%= t('msg_new') %></a></div>
        <div class="list-group list-group-flush">
          <% if (sent && sent.length){ %>
            <% sent.forEach(m=>{ %>
              <a href="/messages/read/<%= m.id %>" class="list-group-item list-group-item-action">
                <div class="fw-bold" style="font-size:.9rem;"><%= m.subject %></div><div class="small text-muted"><%= t('msg_to') %>: <%= m.recipient_name||(m.is_admin_message?t('nav_admin'):'#'+m.recipient_id) %> • <%= new Date(m.created_at).toLocaleString() %></div>
              </a>
            <% }) %>
          <% } else { %><div class="p-4 text-center text-muted"><%= t('msg_empty') %></div><% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<script>try{sessionStorage.setItem('bo_unread','0');}catch(e){}</script>
<%- include('partials/footer') %>
