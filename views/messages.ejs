<%- include('partials/header') %>
<div class="container mt-4">
  <h2 class="fw-bold mb-3"><i class="fas fa-envelope text-danger me-2"></i>Messages <% if (unread_count){ %><span class="badge bg-danger"><%= unread_count %> unread</span><% } %></h2>
  <div class="row g-4">
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm" style="border-radius:18px;">
        <div class="card-header bg-white border-0 pt-3"><h6 class="fw-bold mb-0"><i class="fas fa-inbox me-2"></i>Received</h6></div>
        <div class="list-group list-group-flush">
          <% if (received && received.length){ %>
            <% received.forEach(m=>{ %>
              <a href="/messages/read/<%= m.id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center <%= !m.is_read?'bg-light':'' %>">
                <div><div class="fw-bold" style="font-size:.9rem;"><%= m.subject %></div><div class="small text-muted">From: <%= m.sender_name||('User #'+m.sender_id) %> • <%= new Date(m.created_at).toLocaleString() %></div></div>
                <% if(!m.is_read){ %><span class="badge bg-danger rounded-pill">New</span><% } %>
              </a>
            <% }) %>
          <% } else { %><div class="p-4 text-center text-muted">No received messages.</div><% } %>
        </div>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm" style="border-radius:18px;">
        <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center"><h6 class="fw-bold mb-0"><i class="fas fa-paper-plane me-2"></i>Sent</h6><a href="/messages/send" class="btn btn-sm btn-danger rounded-pill">+ New Message</a></div>
        <div class="list-group list-group-flush">
          <% if (sent && sent.length){ %>
            <% sent.forEach(m=>{ %>
              <a href="/messages/read/<%= m.id %>" class="list-group-item list-group-item-action">
                <div class="fw-bold" style="font-size:.9rem;"><%= m.subject %></div><div class="small text-muted">To: <%= m.recipient_name||(m.is_admin_message?'Admin':'User #'+m.recipient_id) %> • <%= new Date(m.created_at).toLocaleString() %></div>
              </a>
            <% }) %>
          <% } else { %><div class="p-4 text-center text-muted">No sent messages.</div><% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
