<%- include('partials/header') %>
<div class="container mt-4">
  <h2 class="fw-bold mb-3"><i class="fas fa-syringe text-danger me-2"></i>Anti-D Information</h2>
  <% if (antid_info && antid_info.length){ %>
    <div class="row g-3">
      <% antid_info.forEach(a=>{ %>
        <div class="col-md-6">
          <div class="card border-0 shadow-sm h-100" style="border-radius:18px;">
            <div class="card-body">
              <h5 class="fw-bold"><%= a.title %></h5>
              <p class="text-muted"><%= a.description %></p>
              <div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
                <div class="small text-muted">Timing</div><div class="fw-bold"><%= a.timing %></div>
                <div class="small text-muted mt-2">Dosage</div><div class="fw-bold" style="color:var(--primary);"><%= a.dosage %></div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="alert alert-info border-0 rounded-4">No Anti-D info yet. Admin can add via DB.</div>
  <% } %>
</div>
<%- include('partials/footer') %>
