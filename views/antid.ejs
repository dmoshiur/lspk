<%- include('partials/header') %>
<%
  const _t   = (typeof t === 'function') ? t : (k) => k;
  const _esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
  const _ref = (typeof reference !== 'undefined' && reference) ? reference : null;
  const _entries = (typeof entries !== 'undefined' && entries) ? entries : [];
  const _bn = (lang === 'bn');
  const _ar = (lang === 'ar');
%>

<div class="container mt-4 mb-5">
  <!-- ---------- Hero ---------- -->
  <div class="card border-0 shadow-sm overflow-hidden mb-4" style="border-radius:24px; background:linear-gradient(135deg,#7f1d1d 0%, #b91c1c 55%, #e31b23 100%); color:#fff;">
    <div class="card-body p-4 p-lg-5">
      <div class="eyebrow mb-2" style="color:#fecdd3;">Clinical reference</div>
      <h1 class="display-title mb-2" style="color:#fff;"><i class="fas fa-syringe me-2"></i><%= _t('nav_antid') %></h1>
      <p class="mb-0" style="max-width:78ch; color:#ffe4e6; font-size:1.02rem; line-height:1.75;">
        <%= _ref ? _esc(_bn ? _ref.summary.bn : _ar ? _ref.summary.ar : _ref.summary.en) : '' %>
      </p>
      <div class="d-flex flex-wrap gap-2 mt-3 small">
        <span class="badge" style="background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.25);"><i class="fas fa-calendar-check me-1"></i><%= _t('common_updated') %>: <%= _ref ? _ref.updated : '' %></span>
        <span class="badge" style="background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.25);"><i class="fas fa-list-check me-1"></i><%= _ref ? _ref.indications.length : 0 %> indications</span>
        <span class="badge" style="background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.25);"><i class="fas fa-prescription me-1"></i><%= _ref ? _ref.dosing.length : 0 %> dosing rules</span>
        <span class="badge" style="background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.25);"><i class="fas fa-circle-question me-1"></i><%= _ref ? _ref.faq.length : 0 %> FAQs</span>
      </div>
    </div>
  </div>

  <% if (loadError) { %>
    <div class="alert alert-warning border-0 rounded-4 d-flex align-items-start gap-2 mb-4">
      <i class="fas fa-triangle-exclamation mt-1"></i>
      <span><%= lang==='bn'?'লাইভ ডেটাবেস লোড করা যায়নি — নিচের সম্পূর্ণ ক্লিনিক্যাল রেফারেন্স দেখানো হচ্ছে।':lang==='ar'?'تعذّر تحميل قاعدة البيانات — يُعرض المرجع السريري الكامل أدناه.':'The live database could not be reached — the complete built-in clinical reference is shown below.' %></span>
    </div>
  <% } %>

  <div class="row g-4">
    <!-- ---------- Left: the reference ---------- -->
    <div class="col-lg-8">
      <% if (_ref) { %>

        <!-- What it is -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:20px;">
          <div class="card-body p-4">
            <h2 class="h5 fw-bold mb-3"><i class="fas fa-circle-info me-2 text-danger"></i><%= _bn?'অ্যান্টি-ডি কী ও কেন প্রয়োজন':_ar?'ما هو مضاد D ولماذا يُعطى':'What Anti-D is and why it is needed' %></h2>
            <div class="d-grid gap-3">
              <% _ref.whatItIs.forEach(function(s){ %>
                <div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
                  <div class="fw-bold mb-1" style="font-family:var(--font-display); font-size:1.08rem;"><%= _esc(s.title) %></div>
                  <p class="small text-muted mb-0" style="line-height:1.7;"><%= _esc(s.body) %></p>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- Indications -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:20px;">
          <div class="card-body p-4">
            <h2 class="h5 fw-bold mb-3"><i class="fas fa-clipboard-list me-2 text-danger"></i><%= _bn?'কাদের দিতে হবে — নির্দেশনাসমূহ':_ar?'دواعي الاستعمال':'Indications — when Anti-D must be given' %></h2>
            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead><tr><th><%= _bn?'পরিস্থিতি':_ar?'الحالة':'Situation' %></th><th><%= _bn?'কাদের':_ar?'لمن':'Who' %></th><th><%= _bn?'সময়':_ar?'التوقيت':'Timing' %></th><th><%= _bn?'নোট':_ar?'ملاحظة':'Note' %></th></tr></thead>
                <tbody>
                  <% _ref.indications.forEach(function(i){ %>
                    <tr>
                      <td class="fw-bold"><%= _esc(i.condition) %></td>
                      <td class="small"><%= _esc(i.who) %></td>
                      <td class="small"><span class="badge bg-light text-dark border"><%= _esc(i.when) %></span></td>
                      <td class="small text-muted"><%= _esc(i.note) %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Dosing -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:20px;">
          <div class="card-body p-4">
            <h2 class="h5 fw-bold mb-3"><i class="fas fa-prescription me-2 text-danger"></i><%= _bn?'মাত্রা ও পথ':_ar?'الجرعة وطريقة الإعطاء':'Dosage and route' %></h2>
            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead><tr><th><%= _bn?'পরিস্থিতি':_ar?'السيناريو':'Scenario' %></th><th><%= _bn?'মাত্রা':_ar?'الجرعة':'Dose' %></th><th><%= _bn?'পথ':_ar?'الطريق':'Route' %></th><th><%= _bn?'পুনরাবৃত্তি':_ar?'التكرار':'Repeat' %></th></tr></thead>
                <tbody>
                  <% _ref.dosing.forEach(function(d){ %>
                    <tr>
                      <td class="fw-bold"><%= _esc(d.scenario) %></td>
                      <td><span class="badge bg-danger"><%= _esc(d.dose) %></span></td>
                      <td class="small"><%= _esc(d.route) %></td>
                      <td class="small text-muted"><%= _esc(d.repeat) %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Timing schedule -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:20px;">
          <div class="card-body p-4">
            <h2 class="h5 fw-bold mb-3"><i class="fas fa-timeline me-2 text-danger"></i><%= _bn?'সময়সূচি':_ar?'الجدول الزمني':'Timing schedule through pregnancy' %></h2>
            <div class="position-relative ps-4" style="border-left:2px dashed #fecdd3;">
              <% _ref.timing.forEach(function(s){ %>
                <div class="mb-3 position-relative">
                  <span style="position:absolute; left:-25px; top:4px; width:12px; height:12px; border-radius:50%; background:var(--primary); box-shadow:0 0 0 4px #fff0f0;"></span>
                  <div class="fw-bold" style="font-size:.95rem;"><%= _esc(s.milestone) %></div>
                  <div class="small text-muted"><%= _esc(s.action) %></div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- Administration -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:20px;">
          <div class="card-body p-4">
            <h2 class="h5 fw-bold mb-3"><i class="fas fa-hand-holding-medical me-2 text-danger"></i><%= _bn?'প্রয়োগবিধি':_ar?'طريقة الإعطاء':'Administration technique' %></h2>
            <ol class="mb-0 ps-3 d-grid gap-2 small" style="line-height:1.7;">
              <% _ref.administration.forEach(function(a){ %><li><%= _esc(a) %></li><% }) %>
            </ol>
          </div>
        </div>

        <!-- Safety -->
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="border-radius:20px;">
              <div class="card-body p-4">
                <h3 class="h6 fw-bold mb-2"><i class="fas fa-notes-medical me-2 text-warning"></i><%= _bn?'সাধারণ পার্শ্বপ্রতিক্রিয়া':_ar?'آثار جانبية شائعة':'Common side effects' %></h3>
                <ul class="small text-muted mb-0 ps-3 d-grid gap-1"><% _ref.safety.common.forEach(function(x){ %><li><%= _esc(x) %></li><% }) %></ul>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="border-radius:20px;">
              <div class="card-body p-4">
                <h3 class="h6 fw-bold mb-2"><i class="fas fa-triangle-exclamation me-2 text-danger"></i><%= _bn?'বিরল কিন্তু গুরুতর':_ar?'نادرة لكن خطيرة':'Rare but serious' %></h3>
                <ul class="small text-muted mb-0 ps-3 d-grid gap-1"><% _ref.safety.rare.forEach(function(x){ %><li><%= _esc(x) %></li><% }) %></ul>
              </div>
            </div>
          </div>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="border-radius:20px; border-top:4px solid #dc2626 !important;">
              <div class="card-body p-4">
                <h3 class="h6 fw-bold mb-2"><i class="fas fa-ban me-2 text-danger"></i><%= _bn?'প্রতি-নির্দেশনা':_ar?'موانع الاستعمال':'Contraindications' %></h3>
                <ul class="small text-muted mb-0 ps-3 d-grid gap-1"><% _ref.safety.contraindications.forEach(function(x){ %><li><%= _esc(x) %></li><% }) %></ul>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="border-radius:20px; border-top:4px solid #0284c7 !important;">
              <div class="card-body p-4">
                <h3 class="h6 fw-bold mb-2"><i class="fas fa-snowflake me-2 text-info"></i><%= _bn?'সংরক্ষণ ও কোল্ড চেইন':_ar?'التخزين وسلسلة التبريد':'Storage and cold chain' %></h3>
                <ul class="small text-muted mb-0 ps-3 d-grid gap-1"><% _ref.safety.storage.forEach(function(x){ %><li><%= _esc(x) %></li><% }) %></ul>
              </div>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:20px;">
          <div class="card-body p-4">
            <h2 class="h5 fw-bold mb-3"><i class="fas fa-circle-question me-2 text-danger"></i><%= _bn?'সাধারণ প্রশ্ন':_ar?'الأسئلة الشائعة':'Frequently asked questions' %></h2>
            <div class="accordion accordion-flush" id="antidFaq">
              <% _ref.faq.forEach(function(f, i){ %>
                <div class="accordion-item border-0 border-bottom">
                  <h3 class="accordion-header">
                    <button class="accordion-button collapsed fw-bold" style="font-size:.95rem; background:transparent;" type="button" data-bs-toggle="collapse" data-bs-target="#faq<%= i %>"><%= _esc(f.q) %></button>
                  </h3>
                  <div id="faq<%= i %>" class="accordion-collapse collapse" data-bs-parent="#antidFaq">
                    <div class="accordion-body small text-muted pt-0" style="line-height:1.75;"><%= _esc(f.a) %></div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- Sources -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:20px; background:#f8fafc;">
          <div class="card-body p-4">
            <h3 class="h6 fw-bold mb-2"><i class="fas fa-book me-2 text-muted"></i><%= _bn?'তথ্যসূত্র':_ar?'المصادر':'Sources' %></h3>
            <ul class="small text-muted mb-0 ps-3"><% _ref.sources.forEach(function(s){ %><li><%= _esc(s) %></li><% }) %></ul>
            <p class="small text-muted mt-3 mb-0 fst-italic"><i class="fas fa-stethoscope me-1"></i><%= _bn?'এটি সাধারণ তথ্য, চিকিৎসকের পরামর্শের বিকল্প নয়।':_ar?'هذه معلومات عامة ولا تغني عن استشارة الطبيب.':'This is general information and is not a substitute for a doctor’s advice.' %></p>
          </div>
        </div>
      <% } %>
    </div>

    <!-- ---------- Right: quick dose cards + admin entries ---------- -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm mb-3 position-sticky" style="border-radius:20px; top:88px;">
        <div class="card-body p-4">
          <h3 class="h6 fw-bold mb-3"><i class="fas fa-bolt me-2 text-danger"></i><%= _bn?'দ্রুত মাত্রা-কার্ড':_ar?'بطاقات الجرعة السريعة':'Quick dose card' %></h3>
          <div class="d-grid gap-2">
            <% if (_ref) { _ref.dosing.slice(0,4).forEach(function(d){ %>
              <div class="p-3 rounded-4" style="background:linear-gradient(135deg,#fff0f0,#fff); border:1px solid #fecdd3;">
                <div class="small text-muted"><%= _esc(d.scenario) %></div>
                <div class="fw-bold" style="color:var(--primary); font-family:var(--font-display); font-size:1.15rem;"><%= _esc(d.dose) %></div>
                <div class="small text-muted"><%= _esc(d.route) %></div>
              </div>
            <% }) } %>
          </div>

          <hr class="my-3">
          <h3 class="h6 fw-bold mb-2"><i class="fas fa-bag-shopping me-2 text-danger"></i><%= _bn?'দোকানে Anti-D':_ar?'مضاد D في المتجر':'Anti-D in the shop' %></h3>
          <p class="small text-muted"><%= _bn?'Rhophylac Anti-D 300mcg মেডিসিন ক্যাটাগরিতে আছে।':_ar?'يتوفر Rhophylac Anti-D 300mcg ضمن فئة الأدوية.':'Rhophylac Anti-D 300 mcg is listed under the Medicine category.' %></p>
          <a href="/shop?search=Anti-D" class="btn btn-danger btn-sm w-100"><i class="fas fa-cart-shopping me-1"></i><%= _t('nav_shop') %></a>
          <a href="/compatibility" class="btn btn-light border btn-sm w-100 mt-2"><i class="fas fa-vial me-1"></i><%= _t('nav_compatibility') %></a>
          <a href="/reviews" class="btn btn-light border btn-sm w-100 mt-2"><i class="fas fa-star me-1"></i><%= _t('nav_reviews') %></a>
        </div>
      </div>
    </div>
  </div>

  <!-- ---------- Admin-managed entries (merged on top of the reference) ---------- -->
  <% if (_entries.length) { %>
    <div class="mt-4">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h5 fw-bold mb-0"><i class="fas fa-database me-2 text-danger"></i><%= _bn?'অ্যাডমিন-প্রকাশিত এন্ট্রি':_ar?'مشاركات المشرف':'Admin-managed entries' %></h2>
        <span class="badge bg-light text-dark border rounded-pill"><%= _entries.length %> entries</span>
      </div>
      <div class="row g-3">
        <% _entries.forEach(function(a){ %>
          <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius:18px;">
              <div class="card-body p-4">
                <h5 class="fw-bold" style="font-family:var(--font-display); font-size:1.12rem;"><%= _esc(a.title) %></h5>
                <p class="text-muted small" style="line-height:1.65;"><%= _esc(a.description) %></p>
                <div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
                  <div class="small text-muted"><%= _bn?'সময়':_ar?'التوقيت':'Timing' %></div>
                  <div class="fw-bold small"><%= _esc(a.timing) %></div>
                  <% if (a.dosage) { %>
                    <div class="small text-muted mt-2"><%= _bn?'মাত্রা':_ar?'الجرعة':'Dosage' %></div>
                    <div class="fw-bold small" style="color:var(--primary);"><%= _esc(a.dosage) %></div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
