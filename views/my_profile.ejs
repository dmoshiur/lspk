<%- include('partials/header') %>
<div class="container mt-4">
  <div class="row g-4">
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm text-center p-4" style="border-radius:18px;">
        <% if (user.image_file && user.image_file!=='default.jpg'){ %><img src="/uploads/<%= user.image_file %>" class="rounded-circle mx-auto" style="width:120px;height:120px;object-fit:cover; border:4px solid #fff; box-shadow:0 10px 30px rgba(15,23,42,.12);"><% } else { %><img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name) %>&background=e31b23&color=fff&bold=true&size=256" class="rounded-circle mx-auto" style="width:120px;height:120px;object-fit:cover;"><% } %>
        <h4 class="fw-bold mt-3 mb-1"><%= user.name %></h4>
        <div><span class="badge bg-danger rounded-pill"><%= user.blood_group %></span> <% if(user.is_verified){ %><span class="badge bg-success rounded-pill">Verified</span><% } %></div>
        <div class="small text-muted mt-2"><%= user.email %> • <%= user.phone %></div>
        <div class="small text-muted"><%= [user.upazila, user.district, user.division].filter(Boolean).join(', ') %></div>
        <div class="d-grid gap-2 mt-3">
          <a href="/donors/profile/edit" class="btn btn-danger rounded-pill"><i class="fas fa-edit me-1"></i>Edit Profile</a>
          <form method="POST" action="/donors/toggle_status"><button class="btn btn-outline-danger rounded-pill w-100"><i class="fas fa-toggle-on me-1"></i>Toggle Availability (<%= user.can_donate?'Available':'Unavailable' %>)</button></form>
          <% if (!user.is_verified && user.age>=18){ %><form method="POST" action="/donors/apply-for-verification"><button class="btn btn-warning rounded-pill w-100"><i class="fas fa-check-circle me-1"></i>Apply for Verification</button></form><% } %>
        </div>
      </div>
      <% if (currentUser && currentUser.is_admin) { %>
        <div class="card border-0 shadow-sm mt-3 p-3" style="border-radius:18px; background:#f8fafc;">
          <div class="small fw-bold"><i class="fas fa-shield-halved me-1 text-danger"></i>Admin quick</div>
          <div class="d-grid gap-2 mt-2"><a href="/admin" class="btn btn-dark btn-sm rounded-pill">Admin Dashboard</a><a href="/shop/admin/products" class="btn btn-outline-danger btn-sm rounded-pill">Manage Products</a><a href="/shop/admin/orders" class="btn btn-outline-danger btn-sm rounded-pill">Manage Orders</a></div>
        </div>
      <% } %>
    </div>
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm" style="border-radius:18px;">
        <div class="card-header bg-white border-0 pt-4 px-4"><h5 class="fw-bold mb-0">Profile Details</h5></div>
        <div class="card-body px-4">
          <div class="row g-3">
            <div class="col-md-6"><div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="small text-muted">Blood Group</div><div class="fw-bold text-danger"><%= user.blood_group %></div></div></div>
            <div class="col-md-6"><div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="small text-muted">Role</div><div class="fw-bold"><%= user.role %></div></div></div>
            <div class="col-md-6"><div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="small text-muted">Age</div><div class="fw-bold"><%= user.age||'—' %></div></div></div>
            <div class="col-md-6"><div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="small text-muted">Last Donation</div><div class="fw-bold"><%= user.last_donation||'—' %></div></div></div>
            <div class="col-12"><div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;"><div class="small text-muted">Location</div><div class="fw-bold"><%= [user.division, user.district, user.upazila, user.union_area, user.address_holding].filter(Boolean).join(', ') %></div></div></div>
            <div class="col-md-6"><div class="p-3 rounded-4" style="background:#fffbeb; border:1px solid #fde68a;"><div class="small text-muted">Verification</div><div class="fw-bold"><% if(user.is_verified){ %>✅ Verified<% } else { %>⏳ Not Verified<% } %></div><div class="small text-muted">Can donate: <%= user.can_donate?'Yes':'No' %></div></div></div>
            <div class="col-md-6"><div class="p-3 rounded-4" style="background:#f0f9ff; border:1px solid #bae6fd;"><div class="small text-muted">Security</div><div class="fw-bold">Single Session Active</div><div class="small text-muted">IP: <%= user.last_login_ip||'—' %></div></div></div>
            <div class="col-12"><div class="p-3 rounded-4" style="background:#fff; border:1px solid #e2e8f0;"><div class="small text-muted">Saved Payment Numbers</div><div class="d-flex flex-wrap gap-2 mt-1"><span class="badge bg-light text-dark border">bKash: <%= user.bkash_number||'—' %></span><span class="badge bg-light text-dark border">Nagad: <%= user.nagad_number||'—' %></span><span class="badge bg-light text-dark border">Rocket: <%= user.rocket_number||'—' %></span><span class="badge bg-light text-dark border">Upay: <%= user.upay_number||'—' %></span><span class="badge bg-light text-dark border">Pathao: <%= user.pathao_number||'—' %></span><% if(user.card_last_four){ %><span class="badge bg-dark">Card: **** <%= user.card_last_four %></span><% } %></div></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
