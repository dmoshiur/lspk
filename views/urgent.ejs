<%- include('partials/header') %>
<div class="container mt-4">
  <h2 class="fw-bold mb-4 text-danger"><i class="fas fa-bolt me-2"></i>Urgent Blood Requests</h2>
  <% if (urgent_requests && urgent_requests.length){ %>
    <div class="row g-3">
      <% urgent_requests.forEach(r=>{ %>
        <div class="col-md-6">
          <div class="card border-0 shadow-sm" style="border-radius:18px; border-top:4px solid var(--primary);">
            <div class="card-body">
              <div class="d-flex justify-content-between"><span class="badge bg-danger"><%= r.blood_group %></span><span class="badge bg-warning text-dark">URGENT</span></div>
              <h5 class="fw-bold mt-2"><%= r.patient_name %> — <%= r.hospital_name %></h5>
              <div class="small text-muted"><%= [r.location_upazila, r.location_district].filter(Boolean).join(', ') %> • Needed: <%= new Date(r.needed_by).toLocaleString() %></div>
              <div class="small mt-2"><%= r.hospital_address %></div>
              <a href="/blood-request/<%= r.id %>" class="btn btn-danger btn-sm mt-3 rounded-pill">View & Help</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="card border-0 shadow-sm text-center p-5" style="border-radius:18px;"><i class="fas fa-check-circle fa-3x text-success mb-3"></i><h5>No urgent requests right now</h5><p class="text-muted">All urgent cases are handled. Check <a href="/blood-requests">all requests</a>.</p></div>
  <% } %>

  <div class="card border-0 shadow-sm mt-4" style="border-radius:18px;">
    <div class="card-header bg-white border-0 pt-4 px-4"><h5 class="fw-bold mb-0"><i class="fas fa-headset me-2 text-danger"></i>Quick Contact Admin</h5></div>
    <div class="card-body px-4">
      <form method="POST" action="/urgent-contact" class="row g-3">
        <div class="col-md-6"><input name="email" class="form-control" placeholder="Your email (optional)"></div>
        <div class="col-md-6"><input name="subject" class="form-control" placeholder="Subject" required></div>
        <div class="col-12"><textarea name="message" class="form-control" rows="3" placeholder="How can we help with urgent blood?" required></textarea></div>
        <div class="col-12"><button class="btn btn-danger rounded-pill"><i class="fas fa-paper-plane me-1"></i>Send to Admin</button></div>
      </form>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
