<%- include('partials/header') %>
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-lg" style="border-radius:22px;">
        <div class="card-header bg-white border-0 pt-4 px-4">
          <h4 class="fw-bold mb-1"><%= message.subject %></h4>
          <div class="small text-muted"><%= t('msg_from') %>: <%= message.sender_name||message.sender_id %> • <%= t('msg_to') %>: <%= message.recipient_name|| (message.is_admin_message?t('nav_admin'):'—') %> • <%= new Date(message.created_at).toLocaleString() %></div>
        </div>
        <div class="card-body px-4">
          <div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0; white-space:pre-wrap;"><%= message.content %></div>
          <div class="d-flex gap-2 mt-3">
            <a href="/messages" class="btn btn-light border rounded-pill"><%= t('common_back') %></a>
            <a href="/messages/reply/<%= message.id %>" class="btn btn-danger rounded-pill"><i class="fas fa-reply me-1"></i><%= t('msg_reply') %></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
