<%- include('partials/header') %>
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card p-4 p-lg-5 shadow-lg border-0" style="border-radius:22px;">
        <h2 class="text-center mb-4 fw-bold" style="letter-spacing:-.02em; color:var(--primary);"><i class="fas fa-user-plus me-2"></i>Create Your Account</h2>
        <form method="POST" enctype="multipart/form-data" action="/register">
          <div class="mb-4 text-center p-3 rounded-4" style="background:#f8fafc; border:1.5px dashed #e2e8f0;">
            <label class="form-label fw-bold">Profile Picture (Optional)</label>
            <input type="file" class="form-control" name="profile_pic" accept="image/*">
            <small class="text-muted">Max 16MB • JPG/PNG/GIF</small>
          </div>
          <h5 class="text-danger border-bottom pb-2 mb-3"><i class="fas fa-id-card me-2"></i>Personal Information</h5>
          <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Full Name *</label><input type="text" class="form-control" name="name" required placeholder="John Doe"></div>
            <div class="col-md-6 mb-3"><label class="form-label">Mobile Number *</label><input type="tel" class="form-control" name="phone" required placeholder="017XXXXXXXX"></div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Email Address *</label><input type="email" class="form-control" name="email" required placeholder="john@example.com"></div>
            <div class="col-md-6 mb-3"><label class="form-label">Password *</label><input type="password" class="form-control" name="password" required placeholder="Min 6 characters"></div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Date of Birth *</label><input type="date" class="form-control" id="dob" name="date_of_birth" required onchange="calculateAge()"></div>
            <div class="col-md-6 mb-3"><label class="form-label">Age</label><input type="number" class="form-control bg-light" id="age" name="age" readonly placeholder="Auto-calculated"><small class="text-muted">Must be 18+ to donate</small></div>
          </div>
          <div class="mb-3"><label class="form-label">Birth Certificate Number (Optional)</label><input type="text" class="form-control" name="birth_certificate" placeholder="For verification"></div>
          <h5 class="text-danger border-bottom pb-2 mb-3 mt-4"><i class="fas fa-tint me-2"></i>Blood & Role</h5>
          <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Blood Group *</label>
              <select class="form-select" name="blood_group" required><option value="">Select Blood Group</option><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>O+</option><option>O-</option><option>AB+</option><option>AB-</option></select>
            </div>
            <div class="col-md-6 mb-3"><label class="form-label">I want to: *</label>
              <select class="form-select" name="role" required><option value="">Select Role</option><option value="Both">Donate & Request</option><option value="Donor">Donate Only</option><option value="Recipient">Request Only</option><option value="Volunteer">Volunteer</option></select>
            </div>
          </div>
          <h5 class="text-danger border-bottom pb-2 mb-3 mt-4"><i class="fas fa-map-marker-alt me-2"></i>Location Details</h5>
          <div class="row">
            <div class="col-md-4 mb-3"><label class="form-label">Division *</label><select class="form-select" id="division" name="division" required><option value="">Select Division</option></select></div>
            <div class="col-md-4 mb-3"><label class="form-label">District *</label><select class="form-select" id="district" name="district" required disabled><option value="">Select District</option></select></div>
            <div class="col-md-4 mb-3"><label class="form-label">Upazila *</label><select class="form-select" id="upazila" name="upazila" required disabled><option value="">Select Upazila</option></select></div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3"><label class="form-label">Union/Area</label><input type="text" class="form-control" name="union" placeholder="Enter your union"></div>
            <div class="col-md-6 mb-3"><label class="form-label">Holding/House No.</label><input type="text" class="form-control" name="holding" placeholder="House/Road info"></div>
          </div>
          <div class="alert alert-warning border-0" style="border-radius:14px; background:#fffbeb; color:#92400e;"><strong>Note:</strong> Anyone can register. To donate blood, you must be 18+ and get verified by admin.</div>
          <div class="d-grid"><button type="submit" class="btn btn-danger btn-lg" style="border-radius:999px;"><i class="fas fa-user-check me-2"></i>Create Account</button></div>
          <p class="text-center mt-4">Already have an account? <a href="/login" class="text-decoration-none fw-bold" style="color:var(--primary);">Login Here</a></p>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
