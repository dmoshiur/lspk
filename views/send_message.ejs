<%- include('partials/header') %>
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="card border-0 shadow-lg p-4" style="border-radius:22px;">
        <h3 class="fw-bold mb-3"><i class="fas fa-paper-plane me-2 text-danger"></i><%= t('msg_send_title') %></h3>
        <form method="POST">
          <div class="mb-3"><label class="form-label"><%= t('msg_recipient') %></label><input type="email" name="recipient_email" class="form-control" placeholder="user@example.com"></div>
          <div class="mb-3"><label class="form-label"><%= t('msg_subject') %> *</label><input type="text" name="subject" class="form-control" required></div>
          <div class="mb-3"><label class="form-label"><%= t('msg_content') %> *</label><textarea name="content" class="form-control" rows="5" required></textarea></div>
          <div class="d-flex gap-2"><a href="/messages" class="btn btn-light border rounded-pill"><%= t('common_cancel') %></a><button class="btn btn-danger rounded-pill"><%= t('chat_send') %></button></div>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
