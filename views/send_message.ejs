<%- include('partials/header') %>
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="card border-0 shadow-lg p-4" style="border-radius:22px;">
        <h3 class="fw-bold mb-3"><i class="fas fa-paper-plane me-2 text-danger"></i>Send Message</h3>
        <form method="POST">
          <div class="mb-3"><label class="form-label">Recipient Email (leave blank for Admin)</label><input type="email" name="recipient_email" class="form-control" placeholder="user@example.com — empty = Admin"></div>
          <div class="mb-3"><label class="form-label">Subject *</label><input type="text" name="subject" class="form-control" required></div>
          <div class="mb-3"><label class="form-label">Message *</label><textarea name="content" class="form-control" rows="5" required placeholder="Write your message..."></textarea></div>
          <div class="d-flex gap-2"><a href="/messages" class="btn btn-light border rounded-pill">Cancel</a><button class="btn btn-danger rounded-pill">Send</button></div>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
