<%- include('../partials/header') %>
<%
  const _t2 = (typeof t === 'function') ? t : (k) => k;
%>
<div class="container mt-4 mb-5">
  <div class="mb-3">
    <h2 class="fw-bold mb-0"><i class="fas fa-shield-halved text-danger me-2"></i><%= _t2('sec_title') %></h2>
    <small class="text-muted"><%= _t2('dash_security_sub') %></small>
  </div>

  <div class="dash-wrapper gap-4">
    <%- include('_sidebar', { active: active }) %>

    <main class="flex-grow-1" style="min-width:0;">
      <div class="row g-3">
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm" style="border-radius:18px;">
            <div class="card-header bg-white border-0 pt-3"><h6 class="fw-bold mb-0"><i class="fas fa-key me-2 text-danger"></i><%= _t2('sec_change') %></h6></div>
            <div class="card-body">
              <form method="POST" action="/dashboard/security" class="d-grid gap-3">
                <div>
                  <label class="form-label" for="sec-current"><%= _t2('sec_current') %></label>
                  <input id="sec-current" type="password" name="current" class="form-control" required autocomplete="current-password">
                </div>
                <div>
                  <label class="form-label" for="sec-next"><%= _t2('sec_new') %></label>
                  <input id="sec-next" type="password" name="next" class="form-control" required minlength="8" autocomplete="new-password">
                  <div class="form-text"><%= _t2('sec_min8') %></div>
                </div>
                <div>
                  <label class="form-label" for="sec-confirm"><%= _t2('sec_confirm') %></label>
                  <input id="sec-confirm" type="password" name="confirm" class="form-control" required minlength="8" autocomplete="new-password">
                </div>
                <button type="submit" class="btn btn-danger rounded-pill"><i class="fas fa-key me-1"></i><%= _t2('sec_change') %></button>
                <div class="small text-muted"><i class="fas fa-circle-info me-1"></i><%= _t2('sec_sub') %></div>
              </form>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm" style="border-radius:18px;">
            <div class="card-header bg-white border-0 pt-3"><h6 class="fw-bold mb-0"><i class="fas fa-circle-info me-2 text-danger"></i><%= _t2('sec_login_info') %></h6></div>
            <div class="card-body d-grid gap-2">
              <div class="p-3 rounded-4" style="background:#f0f9ff; border:1px solid #bae6fd;">
                <div class="small text-muted"><%= _t2('prof_session') %></div>
                <div class="fw-bold"><i class="fas fa-shield-halved me-1 text-success"></i><%= _t2('auth_single_session') %></div>
                <div class="small text-muted"><%= _t2('auth_single_session_sub') %></div>
              </div>
              <div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
                <div class="small text-muted"><%= _t2('common_email') %></div>
                <div class="fw-bold"><%= user.email %></div>
              </div>
              <div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
                <div class="small text-muted"><%= _t2('prof_last_login_ip') %></div>
                <div class="fw-bold"><%= user.last_login_ip || '—' %></div>
              </div>
              <div class="p-3 rounded-4" style="background:#f8fafc; border:1px solid #e2e8f0;">
                <div class="small text-muted"><%= _t2('common_role') %></div>
                <div class="fw-bold">
                  <% if (user.is_super_admin) { %><span class="badge bg-dark rounded-pill">Super Admin</span>
                  <% } else if (user.is_admin) { %><span class="badge bg-primary rounded-pill">Admin</span>
                  <% } else { %><span class="badge bg-secondary rounded-pill"><%= user.role || 'User' %></span><% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
