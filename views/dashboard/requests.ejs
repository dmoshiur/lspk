<%- include('../partials/header') %>
<%
  const _t2 = (typeof t === 'function') ? t : (k) => k;
  const _esc2 = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
  const fmtDate = (v) => { try { return new Date(String(v).includes('T') ? v : String(v).replace(' ','T') + 'Z').toLocaleString('en-GB', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' }); } catch(e){ return String(v||'').slice(0,16); } };
  const rq = (typeof requests !== 'undefined' && requests) ? requests : { ok: false, list: [] };
%>
<div class="container mt-4 mb-5">
  <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
      <h2 class="fw-bold mb-0"><i class="fas fa-tint text-danger me-2"></i><%= _t2('dash_requests') %></h2>
      <small class="text-muted"><%= _t2('dash_requests_sub') %></small>
    </div>
    <a href="/request-blood" class="btn btn-danger btn-sm rounded-pill"><i class="fas fa-plus-circle me-1"></i><%= _t2('req_new') %></a>
  </div>

  <div class="dash-wrapper gap-4">
    <%- include('_sidebar', { active: active }) %>

    <main class="flex-grow-1" style="min-width:0;">
      <% if (!rq.ok) { %>
        <div class="alert alert-light border small rounded-4"><i class="fas fa-triangle-exclamation text-warning me-2"></i><%= _t2('common_load_failed') %> <a href="javascript:location.reload()" class="fw-bold"><%= _t2('common_retry') %></a></div>
      <% } else if (!rq.list.length) { %>
        <div class="card border-0 shadow-sm text-center p-5" style="border-radius:18px;">
          <i class="fas fa-tint-slash fa-3x mb-3" style="color:#94a3b8;"></i>
          <h5 class="fw-bold"><%= _t2('req_mine_empty') %></h5>
          <a href="/request-blood" class="btn btn-danger rounded-pill mt-2"><%= _t2('req_create_first') %></a>
        </div>
      <% } else { %>
        <div class="row g-3">
          <% rq.list.forEach(function(r){ const done = r.is_fulfilled, gone = r.is_cancelled; %>
            <div class="col-md-6 col-xl-4">
              <div class="card h-100 border-0 shadow-sm" style="border-radius:18px; <%= r.is_urgent && !done && !gone ? 'border-top:4px solid var(--primary);' : '' %>">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-danger rounded-pill" style="font-size:.9rem;"><%= r.blood_group %><%= r.quantity ? ' • ' + r.quantity : '' %></span>
                    <% if (r.is_urgent) { %><span class="badge bg-warning text-dark rounded-pill"><i class="fas fa-bolt me-1"></i><%= _t2('st_urgent') %></span><% } %>
                  </div>
                  <h6 class="fw-bold mb-1"><%= _esc2(r.patient_name) %> <small class="text-muted">(<%= _esc2(r.patient_relation || 'Self') %>)</small></h6>
                  <div class="small text-muted d-grid gap-1">
                    <div><i class="fas fa-hospital me-2 text-danger"></i><%= _esc2(r.hospital_name) %></div>
                    <div><i class="fas fa-map-marker-alt me-2 text-danger"></i><%= _esc2([r.location_upazila, r.location_district, r.location_division].filter(Boolean).join(', ')) %></div>
                    <div><i class="fas fa-clock me-2 text-danger"></i><%= _t2('req_needed') %>: <%= fmtDate(r.needed_by) %></div>
                    <div><i class="fas fa-calendar me-2 text-danger"></i><%= fmtDate(r.created_at) %></div>
                  </div>
                </div>
                <div class="card-footer bg-white border-0 d-flex gap-2 align-items-center">
                  <span class="badge <%= done ? 'bg-success' : gone ? 'bg-secondary' : 'bg-warning text-dark' %> rounded-pill"><%= done ? _t2('st_fulfilled') : gone ? _t2('st_cancelled') : _t2('st_active') %></span>
                  <a href="/blood-request/<%= r.id %>" class="btn btn-sm btn-outline-danger rounded-pill ms-auto"><%= _t2('req_view') %></a>
                  <% if (!done && !gone) { %>
                    <form method="POST" action="/blood-request/<%= r.id %>/cancel">
                      <button class="btn btn-sm btn-outline-secondary rounded-pill" onclick="return confirm('<%= _t2('common_confirm') %>')"><i class="fas fa-ban me-1"></i><%= _t2('common_cancel') %></button>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </main>
  </div>
</div>
<%- include('../partials/footer') %>
