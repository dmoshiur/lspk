<%- include('partials/header') %>
<div class="container mt-4">
  <h2 class="fw-bold mb-3"><i class="fas fa-clipboard-list text-danger me-2"></i>Donation Guidelines</h2>
  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm" style="border-radius:18px;">
        <div class="card-body p-4">
          <h5 class="fw-bold"><i class="fas fa-check-circle text-success me-2"></i>Who Can Donate?</h5>
          <ul class="text-muted">
            <li>Age 18-60, weight ≥45kg</li>
            <li>Hemoglobin ≥12.5 g/dL, not donated in last 90 days</li>
            <li>Healthy, no fever/cold, no recent surgery</li>
            <li>Verified by BloodOra admin</li>
          </ul>
          <h5 class="fw-bold mt-4"><i class="fas fa-ban text-danger me-2"></i>Who Cannot?</h5>
          <ul class="text-muted">
            <li>Under 18, pregnant/breastfeeding</li>
            <li>Recent tattoo/piercing (6 months), infections, chronic illness</li>
            <li>On antibiotics or recently vaccinated (check)</li>
          </ul>
          <h5 class="fw-bold mt-4"><i class="fas fa-heart-pulse text-danger me-2"></i>Before & After</h5>
          <p class="text-muted">Hydrate, eat iron-rich food, sleep well before. After donation, rest 15 min, drink fluids, avoid heavy exercise 24h.</p>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm" style="border-radius:18px; background:linear-gradient(135deg,#fff0f0,#ffe4e6);">
        <div class="card-body">
          <h6 class="fw-bold text-danger"><i class="fas fa-phone me-2"></i>Need Help?</h6>
          <p class="small text-muted">Contact <%= settings && settings.site_phone ? settings.site_phone : '+8801709202140' %> or <%= settings && settings.site_email ? settings.site_email : 'info.bloodora@gmail.com' %></p>
          <a href="/contact" class="btn btn-danger btn-sm rounded-pill">Contact Us</a>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
