<%
  const _t = (typeof t === 'function') ? t : (k) => k;
%>
<%- include('partials/header') %>
<div class="container mt-4">
  <h2 class="fw-bold mb-3"><i class="fas fa-clipboard-list text-danger me-2"></i><%= _t('nav_guidelines') %></h2>
  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm" style="border-radius:18px;">
        <div class="card-body p-4">
          <h5 class="fw-bold"><i class="fas fa-check-circle text-success me-2"></i><%= _t('guide_who_can') %></h5>
          <ul class="text-muted">
            <li><%= _t('guide_who_can_1') %></li>
            <li><%= _t('guide_who_can_2') %></li>
            <li><%= _t('guide_who_can_3') %></li>
            <li><%= _t('guide_who_can_4') %></li>
          </ul>
          <h5 class="fw-bold mt-4"><i class="fas fa-ban text-danger me-2"></i><%= _t('guide_who_cannot') %></h5>
          <ul class="text-muted">
            <li><%= _t('guide_who_cannot_1') %></li>
            <li><%= _t('guide_who_cannot_2') %></li>
            <li><%= _t('guide_who_cannot_3') %></li>
          </ul>
          <h5 class="fw-bold mt-4"><i class="fas fa-heart-pulse text-danger me-2"></i><%= _t('guide_before_after') %></h5>
          <p class="text-muted"><%= _t('guide_before_after_text') %></p>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm" style="border-radius:18px; background:linear-gradient(135deg,#fff0f0,#ffe4e6);">
        <div class="card-body">
          <h6 class="fw-bold text-danger"><i class="fas fa-phone me-2"></i><%= _t('guide_need_help') %></h6>
          <p class="small text-muted"><%= _t('guide_need_help_text') %><br><%= settings && settings.site_phone ? settings.site_phone : '+8801709202140' %> • <%= settings && settings.site_email ? settings.site_email : 'info.bloodora@gmail.com' %></p>
          <a href="/contact" class="btn btn-danger btn-sm rounded-pill"><%= _t('nav_contact') %></a>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
